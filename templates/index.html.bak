    function clearManualContext() {
      const textarea = document.getElementById("manualContextPostText");
      if (textarea) textarea.value = "";
      const contestCheck = document.getElementById("manualContextIsContest");
      if (contestCheck) {
        contestCheck.checked = false;
        toggleManualContextContestFields(false);
      }
      const req = document.getElementById("manualContextContestReq");
      if (req) req.value = "";
