    async function captureAndReadScreen() {
      const btn = document.getElementById("btnCaptureScreen");
      const btnText = document.getElementById("btnCaptureScreenText");
      const origText = btnText ? btnText.innerText : "📸 Capturar y Leer Pantalla";

      if (btn) {
        btn.disabled = true;
        btn.classList.add("opacity-60", "cursor-wait");
      }
      if (btnText) {
        btnText.innerText = "Capturando y leyendo con IA...";
      }

      try {
        const res = await fetch("/api/post/capture-and-read-screen", { method: "POST" });
        const data = await res.json();

        if (!data.success) {
          alert("Aviso de Captura: " + (data.error || "No se pudo capturar la pantalla del dispositivo."));
          return;
        }

        renderCapturedPostData(data);
      } catch (e) {
        alert("Error de conexión al capturar pantalla: " + e);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.classList.remove("opacity-60", "cursor-wait");
        }
        if (btnText) {
          btnText.innerText = origText;
        }
        if (window.lucide) lucide.createIcons();
      }
    }

    async function uploadAndReadScreen(input) {
      if (!input || !input.files || input.files.length === 0) return;
      const file = input.files[0];
      const formData = new FormData();
      formData.append("image", file);

      const btn = document.getElementById("btnCaptureScreen");
      const btnText = document.getElementById("btnCaptureScreenText");
      const origText = btnText ? btnText.innerText : "📸 Capturar y Leer Pantalla";

      if (btn) {
        btn.disabled = true;
        btn.classList.add("opacity-60", "cursor-wait");
      }
      if (btnText) {
        btnText.innerText = "Subiendo y leyendo imagen...";
      }

      try {
        const res = await fetch("/api/post/capture-and-read-screen", {
          method: "POST",
          body: formData
        });
        const data = await res.json();

        if (!data.success) {
          alert("Error al leer la captura subida: " + (data.error || "No se pudo procesar"));
          return;
        }

        renderCapturedPostData(data);
      } catch (e) {
        alert("Error al subir captura: " + e);
      } finally {
        input.value = "";
        if (btn) {
          btn.disabled = false;
          btn.classList.remove("opacity-60", "cursor-wait");
        }
        if (btnText) {
          btnText.innerText = origText;
        }
        if (window.lucide) lucide.createIcons();
      }
    }

    function renderCapturedPostData(data) {
      const card = document.getElementById("capturedScreenPreviewCard");
      const img = document.getElementById("capturedScreenImg");
      const title = document.getElementById("capturedScreenTitle");
      const subtitle = document.getElementById("capturedScreenSubtitle");
      const badges = document.getElementById("capturedScreenBadges");
      const hintBanner = document.getElementById("captureErrorHintBanner");
      const hintText = document.getElementById("captureErrorHintText");

      if (img && data.image_url) {
        img.src = data.image_url;
      }
      if (title) {
        title.innerText = data.is_upload 
          ? `Captura Subida · @${data.author || "publicación"}`
          : `Captura ADB · @${data.author || "instagram"}`;
      }
      if (subtitle) {
        subtitle.innerText = `Tema: ${data.topic || "General"} · Tono: ${data.tone || "Informativo"}`;
      }

      if (badges) {
        let bHtml = "";
        if (data.ai_transcribed) {
          bHtml += `<span class="px-1.5 py-0.5 rounded text-[9px] bg-emerald-950 text-emerald-300 border border-emerald-800 flex items-center space-x-1"><span>✨</span><span>Transcrito por Vision AI</span></span>`;
        } else {
          bHtml += `<span class="px-1.5 py-0.5 rounded text-[9px] bg-amber-950 text-amber-300 border border-amber-800 flex items-center space-x-1"><span>📷</span><span>Imagen Capturada</span></span>`;
        }
        if (data.is_contest) {
          bHtml += `<span class="px-1.5 py-0.5 rounded text-[9px] bg-indigo-950 text-indigo-300 border border-indigo-800 flex items-center space-x-1"><span>🏆</span><span>Dinámica / Concurso</span></span>`;
        }
        badges.innerHTML = bHtml;
      }

      if (hintBanner && hintText) {
        if (!data.ai_transcribed && data.error_hint) {
          hintText.innerText = data.error_hint;
          hintBanner.classList.remove("hidden");
        } else {
          hintBanner.classList.add("hidden");
        }
      }

      if (card) card.classList.remove("hidden");

      // Populate text context
      const textarea = document.getElementById("manualContextPostText");
      if (textarea && data.extracted_text) {
        textarea.value = data.extracted_text;
        textarea.classList.add("ring-2", "ring-sky-500");
        setTimeout(() => textarea.classList.remove("ring-2", "ring-sky-500"), 1200);
      }

      // Populate contest details if detected
      if (data.is_contest) {
        const contestCb = document.getElementById("manualContextIsContest");
        if (contestCb) {
          contestCb.checked = true;
          toggleManualContextContestFields(true);
        }
        const reqInput = document.getElementById("manualContextContestReq");
        if (reqInput && data.contest_requirement) {
          reqInput.value = data.contest_requirement;
        }
        const topicInput = document.getElementById("manualContextContestTopic");
        if (topicInput && data.teams_or_topic) {
          topicInput.value = data.teams_or_topic;
        }
      }

      // Automatic trigger of analysis and previews
      if (data.extracted_text && data.extracted_text.length > 5) {
        analyzePostAndPreviewComments();
      } else if (textarea) {
        textarea.focus();
      }

      if (window.lucide) lucide.createIcons();
    }

    function dismissCapturedScreen() {
      const card = document.getElementById("capturedScreenPreviewCard");
      if (card) card.classList.add("hidden");
    }

    function expandCapturedScreen() {
      const img = document.getElementById("capturedScreenImg");
      const modalImg = document.getElementById("modalScreenImg");
      const modal = document.getElementById("screenModal");
      if (img && modalImg && modal) {
        modalImg.src = img.src;
        modal.classList.remove("hidden");
      }
    }

    function closeScreenModal(e) {
      const modal = document.getElementById("screenModal");
      if (modal) modal.classList.add("hidden");
    }

    async function extractScreenContext() {
      return captureAndReadScreen();
    }

    async function captureAndReadForSimulator() {
      try {
        const res = await fetch("/api/post/capture-and-read-screen", { method: "POST" });
        const data = await res.json();
        if (data.success && data.extracted_text) {
          const simText = document.getElementById("simPostText");
          if (simText) simText.value = data.extracted_text;
          if (data.is_contest) {
            const simCb = document.getElementById("simIsContest");
            if (simCb) {
              simCb.checked = true;
              toggleSimContestFields(true);
            }
            const simReq = document.getElementById("simContestReq");
            if (simReq && data.contest_requirement) simReq.value = data.contest_requirement;
            const simTopic = document.getElementById("simContestTopic");
            if (simTopic && data.teams_or_topic) simTopic.value = data.teams_or_topic;
          }
          previewComments();
        } else {
          alert("Aviso: " + (data.error || "No se pudo extraer texto de la captura para el simulador."));
        }
      } catch (e) {
        alert("Error al capturar para el simulador: " + e);
      }
    }

    function escapeHtmlQuotes(str) {
      if (!str) return "";
      return str.replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/"/g, "&quot;").replace(/\n/g, " ");
    }

    function useCommentAsCustom(text) {
      const customInput = document.getElementById("cycleCustomComment");
      if (customInput) {
        customInput.value = text;
        customInput.scrollIntoView({ behavior: "smooth", block: "center" });
        customInput.classList.add("ring-2", "ring-emerald-500", "bg-emerald-950/40");
        setTimeout(() => {
          customInput.classList.remove("ring-2", "ring-emerald-500", "bg-emerald-950/40");
        }, 1800);
      }
    }

    // --- Gestor de Modos de Comentarios & Banco de Comentarios Pegados ---
    function selectCommentMode(mode) {
      const modeInput = document.getElementById("selectedCommentMode");
      const autoCard = document.getElementById("commentModeAutoCard");
      const presetCard = document.getElementById("commentModePresetCard");
      const dotAuto = document.getElementById("radioDotAuto");
      const dotPreset = document.getElementById("radioDotPreset");
      const badgeLeft = document.getElementById("currentCommentModeBadge");

      if (modeInput) modeInput.value = mode;

      if (mode === "preset_list") {
        if (autoCard) {
          autoCard.className = "cursor-pointer rounded-xl border-2 border-slate-800 bg-slate-900/60 hover:border-slate-700 p-3 space-y-1.5 transition-all";
        }
        if (presetCard) {
          presetCard.className = "cursor-pointer rounded-xl border-2 border-sky-500 bg-sky-950/25 p-3 space-y-1.5 transition-all shadow-md shadow-sky-950/20";
        }
        if (dotAuto) {
          dotAuto.parentElement.className = "w-4 h-4 rounded-full border-2 border-slate-600 flex items-center justify-center bg-transparent";
          dotAuto.className = "w-1.5 h-1.5 rounded-full bg-transparent";
        }
        if (dotPreset) {
          dotPreset.parentElement.className = "w-4 h-4 rounded-full border-2 border-sky-400 flex items-center justify-center bg-sky-500";
          dotPreset.className = "w-1.5 h-1.5 rounded-full bg-slate-950";
        }
        if (badgeLeft) {
          badgeLeft.innerText = "📝 Lista Predefinida";
          badgeLeft.className = "text-sky-300";
        }
      } else {
        if (autoCard) {
          autoCard.className = "cursor-pointer rounded-xl border-2 border-amber-500 bg-amber-950/25 p-3 space-y-1.5 transition-all shadow-md shadow-amber-950/20";
        }
        if (presetCard) {
          presetCard.className = "cursor-pointer rounded-xl border-2 border-slate-800 bg-slate-900/60 hover:border-slate-700 p-3 space-y-1.5 transition-all";
        }
        if (dotAuto) {
          dotAuto.parentElement.className = "w-4 h-4 rounded-full border-2 border-amber-400 flex items-center justify-center bg-amber-500";
          dotAuto.className = "w-1.5 h-1.5 rounded-full bg-slate-950";
        }
        if (dotPreset) {
          dotPreset.parentElement.className = "w-4 h-4 rounded-full border-2 border-slate-600 flex items-center justify-center bg-transparent";
          dotPreset.className = "w-1.5 h-1.5 rounded-full bg-transparent";
        }
        if (badgeLeft) {
          badgeLeft.innerText = "🤖 Autónomo IA";
          badgeLeft.className = "text-amber-300";
        }
      }
    }

    function updatePastedCommentsCount() {
      const textarea = document.getElementById("pastedCommentsTextarea");
      const badge = document.getElementById("pastedCommentsBadge");
      if (!textarea) return;

      const lines = textarea.value.split("\n").map(l => l.trim()).filter(Boolean);
      const count = lines.length;

      try {
        localStorage.setItem("granjita_pasted_comments", textarea.value);
      } catch (e) {}

      if (badge) {
        if (count >= 10) {
          badge.innerText = `${count} comentarios (Listo)`;
          badge.className = "text-[10px] px-2 py-0.5 rounded-full font-mono bg-emerald-950 text-emerald-300 border border-emerald-800 font-bold";
        } else if (count > 0) {
          badge.innerText = `${count} comentario${count > 1 ? 's' : ''} (Recomendado 10+)`;
          badge.className = "text-[10px] px-2 py-0.5 rounded-full font-mono bg-amber-950 text-amber-300 border border-amber-800";
        } else {
          badge.innerText = "0 comentarios";
          badge.className = "text-[10px] px-2 py-0.5 rounded-full font-mono bg-slate-800 text-slate-400 border border-slate-700";
        }
      }
    }

    function shufflePastedComments() {
      const textarea = document.getElementById("pastedCommentsTextarea");
      if (!textarea) return;
      const lines = textarea.value.split("\n").map(l => l.trim()).filter(Boolean);
      if (lines.length < 2) return;
      for (let i = lines.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [lines[i], lines[j]] = [lines[j], lines[i]];
      }
      textarea.value = lines.join("\n");
      updatePastedCommentsCount();
    }

    function clearPastedComments() {
      const textarea = document.getElementById("pastedCommentsTextarea");
      if (!textarea) return;
      if (textarea.value.trim() && !confirm("¿Deseas limpiar todos los comentarios pegados?")) return;
      textarea.value = "";
      updatePastedCommentsCount();
    }

    function addCommentToPastedList(commentText) {
      if (!commentText) return;
      const textarea = document.getElementById("pastedCommentsTextarea");
      if (!textarea) return;
      const current = textarea.value.trim();
      const cleanComment = commentText.replace(/[\r\n]+/g, ' ').trim();
      if (current) {
        textarea.value = current + "\n" + cleanComment;
      } else {
        textarea.value = cleanComment;
      }
      updatePastedCommentsCount();
      // Visual feedback
      textarea.classList.add("ring-2", "ring-emerald-500");
      setTimeout(() => textarea.classList.remove("ring-2", "ring-emerald-500"), 900);
    }

    function appendSuggestionsToPastedList() {
      const textarea = document.getElementById("pastedCommentsTextarea");
      if (!textarea) return;
      if (!window.lastAnalysisData) {
        alert("Primero pulsa '🔍 Analizar Publicación y Previsualizar Comentarios' para que la IA procese la publicación.");
        return;
      }
      const data = window.lastAnalysisData;
      const candidates = [];
      (data.human_samples || []).forEach(hs => {
        if (hs.comment) candidates.push(hs.comment.replace(/[\r\n]+/g, ' ').trim());
      });
      (data.narrative_samples || []).forEach(ns => {
        if (ns.comment) candidates.push(ns.comment.replace(/[\r\n]+/g, ' ').trim());
      });
      (data.account_samples || []).forEach(as => {
        if (as.comment) candidates.push(as.comment.replace(/[\r\n]+/g, ' ').trim());
      });

      if (candidates.length === 0) {
        alert("No se encontraron comentarios generados en el último análisis.");
        return;
      }

      const existingLines = textarea.value.split("\n").map(l => l.trim()).filter(Boolean);
      let added = 0;
      candidates.forEach(c => {
        if (!existingLines.includes(c)) {
          existingLines.push(c);
          added++;
        }
      });
      textarea.value = existingLines.join("\n");
      updatePastedCommentsCount();
      alert(`Se añadieron ${added} comentarios sugeridos al banco de comentarios.`);
    }

    async function analyzePostAndPreviewComments() {
      const text = document.getElementById("manualContextPostText")?.value.trim();
      if (!text) {
        alert("Por favor escribe o pega la descripción del post, o pulsa '📸 Capturar y Leer Pantalla' si ya está abierto en tu teléfono.");
        document.getElementById("manualContextPostText")?.focus();
        return;
      }

      const btn = document.getElementById("btnAnalyzePost");
      const btnIcon = document.getElementById("analyzePostIcon");
      const btnText = document.getElementById("analyzePostBtnText");

      // Switch automatically to the Right Column "Comentarios & Análisis" tab
      switchTab('comments');

      const rAnalysisBox = document.getElementById("rightAnalysisContainer");
      const rEmptyState = document.getElementById("rightCommentsEmptyState");
      const rSummary = document.getElementById("rightAnalysisSummary");
      const rBadges = document.getElementById("rightAnalysisBadges");
      const rDetails = document.getElementById("rightAnalysisDetailsGrid");
      const rHumanList = document.getElementById("rightHumanSamplesList");
      const rNarrativeList = document.getElementById("rightNarrativeSamplesList");
      const rAccountBox = document.getElementById("rightAccountSamplesContainer");
      const rAccountList = document.getElementById("rightAccountSamplesList");
      const rAccountBadge = document.getElementById("rightAccountSamplesCountBadge");

      // Left column mini alert
      const miniAlert = document.getElementById("analysisAndPreviewBox");
      const miniBadge = document.getElementById("analysisTopicBadgeMini");
      const miniSummary = document.getElementById("analysisSummaryTextMini");

      const narrative = document.getElementById("cycleNarrativeSelect")?.value || "a_favor";
      const accountsToUse = parseInt(document.getElementById("accountsToUseInput")?.value) || 1;
      const isContest = document.getElementById("manualContextIsContest")?.checked || false;
      const contestReq = document.getElementById("manualContextContestReq")?.value.trim() || "";
      const contestTopic = document.getElementById("manualContextContestTopic")?.value.trim() || "";
      const textModel = document.getElementById("selectTextModel")?.value || "";

      if (btn) { btn.disabled = true; btn.classList.add("opacity-50"); }
      if (btnText) btnText.innerText = "Analizando post en columna derecha...";
      if (btnIcon) btnIcon.classList.add("animate-spin");

      try {
        const res = await fetch("/api/post/analyze-and-preview", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            text: text,
            narrative: narrative,
            accounts_to_use: accountsToUse,
            text_model: textModel,
            is_contest: isContest,
            contest_requirement: contestReq,
            teams_or_topic: contestTopic
          })
        });
        const data = await res.json();
        if (!data.success) {
          alert("Error en el análisis: " + (data.error || "Ocurrió un error inesperado"));
          return;
        }

        window.lastAnalysisData = data;

        // Show right container & hide empty state
        if (rAnalysisBox) rAnalysisBox.classList.remove("hidden");
        if (rEmptyState) rEmptyState.classList.add("hidden");

        // 1. Render Analysis
        const analysis = data.analysis || {};
        if (rSummary) rSummary.innerText = analysis.summary || "Publicación analizada correctamente.";

        if (rBadges) {
          rBadges.innerHTML = `
            <span class="px-2 py-0.5 rounded bg-sky-950 text-sky-300 border border-sky-800 text-[10px] font-medium font-mono">${escapeHtml(analysis.topic || 'General')}</span>
            <span class="px-2 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-800 text-[10px] font-medium font-mono">${escapeHtml(analysis.tone || 'Neutro')}</span>
            ${analysis.is_contest ? '<span class="px-2 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800 text-[10px] font-bold font-mono">🏆 Dinámica / Concurso</span>' : ''}
          `;
        }

        if (rDetails) {
          rDetails.innerHTML = `
            ${analysis.is_contest && analysis.contest_requirement ? `
              <div class="col-span-full bg-amber-950/40 border border-amber-800/60 rounded-lg p-2.5 text-amber-200">
                <span class="font-bold text-amber-400 block mb-0.5">📌 Requisito / Dinámica del Concurso:</span>
                <span>${escapeHtml(analysis.contest_requirement)}</span>
              </div>
            ` : ''}
            ${analysis.teams_or_topic ? `
              <div class="bg-slate-900 border border-slate-800 rounded-lg p-2">
                <span class="font-bold text-slate-300 block mb-0.5">⚽ Equipos / Tema:</span>
                <span class="text-slate-200">${escapeHtml(analysis.teams_or_topic)}</span>
              </div>
            ` : ''}
            ${analysis.suggested_approach ? `
              <div class="bg-slate-900 border border-slate-800 rounded-lg p-2">
                <span class="font-bold text-emerald-400 block mb-0.5">💡 Consejo de Enfoque:</span>
                <span class="text-slate-200">${escapeHtml(analysis.suggested_approach)}</span>
              </div>
            ` : ''}
          `;
        }

        // Auto-fill contest fields if detected
        if (analysis.is_contest && !document.getElementById("manualContextIsContest")?.checked) {
          const contestCheck = document.getElementById("manualContextIsContest");
          if (contestCheck) {
            contestCheck.checked = true;
            toggleManualContextContestFields(true);
          }
          if (analysis.contest_requirement && !document.getElementById("manualContextContestReq")?.value) {
            document.getElementById("manualContextContestReq").value = analysis.contest_requirement;
          }
          if (analysis.teams_or_topic && !document.getElementById("manualContextContestTopic")?.value) {
            document.getElementById("manualContextContestTopic").value = analysis.teams_or_topic;
          }
        }

        // 2. Render 5 Human Archetypes with Persistent Memory (agents.md)
        const humanSamples = data.human_samples || [];
        if (rHumanList && humanSamples.length > 0) {
          rHumanList.innerHTML = "";
          humanSamples.forEach(hs => {
            const card = document.createElement("div");
            card.className = "bg-slate-900/90 border border-amber-900/50 hover:border-amber-700/70 rounded-xl p-2.5 space-y-1.5 transition";
            card.innerHTML = `
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-1.5 flex-wrap gap-y-1">
                  <span class="px-2 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800 text-[10px] font-bold">
                    ${escapeHtml(hs.name)}
                  </span>
                  <span class="px-1.5 py-0.2 rounded bg-teal-950 text-teal-300 border border-teal-800 text-[9px] font-mono">
                    👁️ Ref: "${escapeHtml(hs.visual_element || 'el entorno')}"
                  </span>
                  <span class="text-[9px] text-emerald-400 font-mono">0 emojis · max 3 líneas</span>
                </div>
                <div class="flex items-center space-x-1">
                  <button type="button" onclick="addCommentToPastedList('${escapeHtmlQuotes(hs.comment)}')" 
                          class="px-2 py-0.5 bg-amber-950/60 hover:bg-amber-800 active:scale-95 text-amber-300 hover:text-white border border-amber-800/80 rounded-lg text-[10px] font-semibold transition flex items-center space-x-0.5 cursor-pointer" title="Añadir este comentario a tu lista de comentarios pegados">
                    <i data-lucide="plus" class="w-3 h-3"></i>
                    <span>Añadir a lista</span>
                  </button>
                  <button type="button" onclick="useCommentAsCustom('${escapeHtmlQuotes(hs.comment)}')" 
                          class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-300 hover:text-white border border-slate-700 rounded-lg text-[10px] font-semibold transition flex items-center space-x-0.5 cursor-pointer" title="Fijar como comentario único">
                    <span>Usar único</span>
                  </button>
                </div>
              </div>
              <p class="text-slate-100 text-xs italic font-sans leading-relaxed pl-1 border-l-2 border-amber-500/60">"${escapeHtml(hs.comment)}"</p>
              <p class="text-[10px] text-slate-400 pl-1">${escapeHtml(hs.description || '')}</p>
            `;
            rHumanList.appendChild(card);
          });
        }

        // 3. Render Narrative Samples (4 posturas)
        if (rNarrativeList) {
          rNarrativeList.innerHTML = "";
          const samples = data.narrative_samples || [];
          samples.forEach(sample => {
            const badgeColors = {
              "emerald": "bg-emerald-950 text-emerald-300 border-emerald-800",
              "sky": "bg-sky-950 text-sky-300 border-sky-800",
              "rose": "bg-rose-950 text-rose-300 border-rose-800",
              "slate": "bg-slate-800 text-slate-300 border-slate-700"
            };
            const colorClass = badgeColors[sample.badge_color] || badgeColors["slate"];

            const card = document.createElement("div");
            card.className = "bg-slate-900/90 border border-slate-800 hover:border-slate-700 rounded-xl p-2.5 space-y-1.5 transition";
            card.innerHTML = `
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-1.5">
                  <span class="px-2 py-0.5 rounded ${colorClass} text-[10px] font-bold">${escapeHtml(sample.badge || sample.label)}</span>
                  <span class="text-[10px] text-slate-400 font-medium">${escapeHtml(sample.archetype_name || '')}</span>
                  <span class="px-1.5 py-0.2 rounded bg-amber-950 text-amber-300 border border-amber-800 text-[9px] font-mono">${escapeHtml(sample.regionalism || '')}</span>
                </div>
                <div class="flex items-center space-x-1">
                  <button type="button" onclick="addCommentToPastedList('${escapeHtmlQuotes(sample.comment)}')" 
                          class="px-2 py-0.5 bg-amber-950/60 hover:bg-amber-800 active:scale-95 text-amber-300 hover:text-white border border-amber-800/80 rounded-lg text-[10px] font-semibold transition flex items-center space-x-0.5 cursor-pointer" title="Añadir este comentario a tu lista">
                    <i data-lucide="plus" class="w-3 h-3"></i>
                    <span>Añadir a lista</span>
                  </button>
                  <button type="button" onclick="useCommentAsCustom('${escapeHtmlQuotes(sample.comment)}')" 
                          class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-300 hover:text-white border border-slate-700 rounded-lg text-[10px] font-semibold transition flex items-center space-x-0.5 cursor-pointer" title="Fijar como comentario único">
                    <span>Usar único</span>
                  </button>
                </div>
              </div>
              <p class="text-slate-100 text-xs italic font-sans leading-relaxed pl-1 border-l-2 border-amber-500/40">"${escapeHtml(sample.comment)}"</p>
              <p class="text-[10px] text-slate-500 pl-1">${escapeHtml(sample.description || '')}</p>
            `;
            rNarrativeList.appendChild(card);
          });
        }

        // 4. Render Account Samples (para las cuentas del ciclo)
        const accSamples = data.account_samples || [];
        if (rAccountBox && accSamples.length > 0) {
          rAccountBox.classList.remove("hidden");
          if (rAccountBadge) rAccountBadge.innerText = `${accSamples.length} cuenta${accSamples.length > 1 ? 's' : ''}`;
          if (rAccountList) {
            rAccountList.innerHTML = "";
            accSamples.forEach(acc => {
              const card = document.createElement("div");
              card.className = "bg-slate-900/80 border border-slate-800 rounded-xl p-2.5 space-y-1 text-xs";
              card.innerHTML = `
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-1.5">
                    <span class="font-bold text-indigo-400 text-[11px]">${escapeHtml(acc.account_label)}:</span>
                    <span class="text-slate-300 text-[11px]">${escapeHtml(acc.archetype_name)}</span>
                    <span class="px-1.5 py-0.2 rounded bg-amber-950 text-amber-300 border border-amber-800 text-[9px] font-mono">${escapeHtml(acc.regionalism)}</span>
                  </div>
                  <div class="flex items-center space-x-1">
                    <button type="button" onclick="addCommentToPastedList('${escapeHtmlQuotes(acc.comment)}')" 
                            class="px-2 py-0.5 bg-indigo-950/60 hover:bg-indigo-800 text-indigo-300 hover:text-white border border-indigo-800/80 rounded-lg text-[10px] font-medium transition cursor-pointer">
                      <span>+ Lista</span>
                    </button>
                    <button type="button" onclick="useCommentAsCustom('${escapeHtmlQuotes(acc.comment)}')" 
                            class="px-2 py-0.5 bg-slate-800 hover:bg-indigo-700 text-slate-300 hover:text-white border border-slate-700 rounded-lg text-[10px] font-medium transition cursor-pointer">
                      <span>Usar</span>
                    </button>
                  </div>
                </div>
                <p class="text-slate-200 text-[11px] italic font-sans leading-relaxed">"${escapeHtml(acc.comment)}"</p>
              `;
              rAccountList.appendChild(card);
            });
          }
        } else if (rAccountBox) {
          rAccountBox.classList.add("hidden");
        }

        // Left column mini alert update
        if (miniAlert) miniAlert.classList.remove("hidden");
        if (miniBadge) miniBadge.innerText = analysis.topic || "Analizado";
        if (miniSummary) miniSummary.innerText = analysis.summary || "Publicación analizada.";

        if (window.lucide) lucide.createIcons();

      } catch (e) {
        alert("Error de red al analizar publicación: " + e);
      } finally {
        if (btn) { btn.disabled = false; btn.classList.remove("opacity-50"); }
        if (btnText) btnText.innerText = "🔍 Analizar Publicación y Previsualizar Comentarios";
        if (btnIcon) btnIcon.classList.remove("animate-spin");
        if (window.lucide) lucide.createIcons();
      }
    }

    // Comment Simulator & Archetype Preview API
    async function previewComments() {
      const postText = document.getElementById("simPostText")?.value.trim();
      const narrative = document.getElementById("simNarrativeSelect")?.value || "a_favor";
      const archChoice = document.getElementById("simArchetypeSelect")?.value || "all";
      const btn = document.getElementById("btnRunPreview");
      const btnText = document.getElementById("simBtnText");
      const btnIcon = document.getElementById("simBtnIcon");
      const container = document.getElementById("simResultsContainer");

      if (!postText) {
        alert("Por favor escribe o pega el texto de una publicación para simular los comentarios.");
        document.getElementById("simPostText")?.focus();
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.classList.add("opacity-50", "cursor-not-allowed");
      }
      if (btnText) btnText.innerText = "Generando con IA local...";
      if (btnIcon) btnIcon.classList.add("animate-spin");

      const isHumanChoice = archChoice === "human_all" || ["Testigo Silencioso", "Buscador", "Guerrero Interior", "Caminante", "Heredero"].includes(archChoice);
      const loadingMsg = archChoice === "human_all" 
        ? "Generando comentarios para los 5 Arquetipos Humanos con memoria de agents.md..." 
        : (archChoice === "all" 
            ? "Generando 6 comentarios con IA local (un comentario por arquetipo)..." 
            : `Generando comentario para ${archChoice} con IA local...`);

      container.innerHTML = `
        <div class="h-44 border border-slate-800 rounded-2xl flex flex-col items-center justify-center text-slate-400 p-4 text-center bg-slate-950/40">
          <i data-lucide="loader-2" class="w-8 h-8 mb-2 text-amber-400 animate-spin"></i>
          <p class="text-xs font-semibold text-slate-200">${loadingMsg}</p>
          <p class="text-[11px] text-slate-500 mt-1">Evaluando postura: <span class="text-amber-400 font-mono font-bold">${narrative}</span> | Cero emojis · Máx 3 líneas</p>
        </div>
      `;
      if (window.lucide) lucide.createIcons();

      try {
        const currentTextModel = document.getElementById("selectTextModel")?.value || "";
        const isContest = document.getElementById("simIsContest")?.checked || false;
        const contestReq = document.getElementById("simContestReq")?.value.trim() || "";
        const contestTopic = document.getElementById("simContestTopic")?.value.trim() || "";

        const res = await fetch("/api/comments/preview", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ 
            text: postText, 
            narrative: narrative, 
            archetype_id: archChoice,
            text_model: currentTextModel,
            is_contest: isContest,
            contest_requirement: contestReq,
            teams_or_topic: contestTopic
          })
        });
        const data = await res.json();

        const items = data.results || data.previews || [];

        if (data.success && items.length > 0) {
          container.innerHTML = "";

          const narrativeBadges = {
            "a_favor": { label: "👍 A Favor / Apoyo", color: "bg-emerald-950/80 text-emerald-300 border-emerald-700" },
            "participacion": { label: "💬 Participación / Pregunta", color: "bg-sky-950/80 text-sky-300 border-sky-700" },
            "hate": { label: "⚡ Crítico / Hate", color: "bg-rose-950/80 text-rose-300 border-rose-700" },
            "neutro": { label: "⚖️ Neutro / Hechos", color: "bg-slate-800 text-slate-300 border-slate-700" }
          };

          const activeBadge = narrativeBadges[data.narrative] || narrativeBadges["a_favor"];

          items.forEach((item) => {
            const archId = item.id || item.archetype_id || "";
            const archName = item.name || item.archetype_name || "Arquetipo";
            const commentText = item.comment || "";
            const words = item.word_count || commentText.split(/\s+/).filter(Boolean).length;
            const reg = item.regionalism || "";
            const visElem = item.visual_element || "";
            const isHuman = item.is_human || ["testigo silencioso", "buscador", "guerrero interior", "caminante", "heredero"].includes(archName.toLowerCase());
            const hasContest = item.contest_info || data.contest_info;

            const card = document.createElement("div");
            card.className = "bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl p-3.5 space-y-2.5 shadow transition";

            card.innerHTML = `
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2 flex-wrap gap-y-1">
                  <span class="px-2 py-0.5 rounded-md bg-amber-950/70 border border-amber-800/80 text-amber-300 text-[11px] font-bold">
                    ${isHuman ? '✨ ' : 'Arquetipo ' + archId + ': '}${escapeHtml(archName)}
                  </span>
                  ${isHuman ? `
                    <span class="px-2 py-0.5 rounded-md bg-teal-950/70 border border-teal-800/80 text-teal-300 text-[10px] font-mono font-semibold">
                      👁️ Ref: "${escapeHtml(visElem || reg || 'el entorno')}"
                    </span>
                  ` : `
                    <span class="px-2 py-0.5 rounded-md bg-purple-950/70 border border-purple-800/80 text-purple-300 text-[10px] font-mono font-semibold">
                      Modismo: "${escapeHtml(reg)}"
                    </span>
                  `}
                  ${hasContest ? '<span class="px-2 py-0.5 rounded-md bg-amber-950/90 text-amber-300 border border-amber-700 text-[10px] font-semibold flex items-center space-x-1"><span>🏆 Dinámica Activa</span></span>' : ''}
                </div>
                <div class="flex items-center space-x-1.5">
                  <span class="text-[10px] px-2 py-0.5 rounded border ${activeBadge.color}">
                    ${activeBadge.label}
                  </span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-950 text-slate-400 border border-slate-800 font-mono">
                    ${words} palabras
                  </span>
                </div>
              </div>

              <div class="bg-slate-950 p-3 rounded-lg border border-slate-800/80">
                <p class="text-xs text-slate-200 italic leading-relaxed font-sans">
                  "${escapeHtml(commentText)}"
                </p>
              </div>

              <div class="flex items-center justify-between pt-1">
                <span class="text-[10px] text-emerald-400 flex items-center space-x-1">
                  <i data-lucide="check-circle-2" class="w-3 h-3"></i>
                  <span>0 Emojis · Máx 3 Líneas · Neutro</span>
                </span>
                <div class="flex space-x-2">
                  <button onclick="copyToClipboard('${escapeHtml(commentText).replace(/'/g, "\\'")}')" 
                          class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 active:scale-95 text-slate-300 text-[11px] rounded-lg border border-slate-700 flex items-center space-x-1 transition cursor-pointer" title="Copiar al portapapeles">
                    <i data-lucide="copy" class="w-3 h-3"></i>
                    <span>Copiar</span>
                  </button>
                  <button onclick="copyToCycleComment('${escapeHtml(commentText).replace(/'/g, "\\'")}')" 
                          class="px-2.5 py-1 bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 active:scale-95 text-white font-semibold text-[11px] rounded-lg shadow flex items-center space-x-1 transition cursor-pointer" title="Usar este comentario en el Ciclo Multi-Cuenta">
                    <i data-lucide="arrow-left-right" class="w-3 h-3"></i>
                    <span>Usar en Ciclo</span>
                  </button>
                </div>
              </div>
            `;
            container.appendChild(card);
          });
          if (window.lucide) lucide.createIcons();
        } else {
          container.innerHTML = `
            <div class="p-4 bg-rose-950/40 border border-rose-800 text-rose-300 text-xs rounded-xl">
              Error al generar comentarios: ${escapeHtml(data.error || "No se recibieron resultados de la IA local.")}
            </div>
          `;
        }
      } catch (err) {
        container.innerHTML = `
          <div class="p-4 bg-rose-950/40 border border-rose-800 text-rose-300 text-xs rounded-xl">
            Error de conexión con el servidor: ${escapeHtml(err.message || err)}
          </div>
        `;
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.classList.remove("opacity-50", "cursor-not-allowed");
        }
        if (btnText) btnText.innerText = "Simular Comentarios";
        if (btnIcon) btnIcon.classList.remove("animate-spin");
      }
    }

    function copyToCycleComment(commentText) {
      const input = document.getElementById("cycleCustomComment");
      if (input) {
        input.value = commentText;
        input.scrollIntoView({ behavior: 'smooth', block: 'center' });
        input.focus();
      }
      const simNarrative = document.getElementById("simNarrativeSelect")?.value;
      const cycleNarrative = document.getElementById("cycleNarrativeSelect");
      if (simNarrative && cycleNarrative) {
        cycleNarrative.value = simNarrative;
      }
      alert("✅ Comentario copiado al Ciclo Multi-Cuenta:\n\"" + commentText + "\"");
    }

    async function showMemoryModal() {
      const modal = document.getElementById("memoryModal");
      if (modal) modal.classList.remove("hidden");
      await refreshMemoryModal();
    }

    function closeMemoryModal() {
      const modal = document.getElementById("memoryModal");
      if (modal) modal.classList.add("hidden");
    }

    async function refreshMemoryModal() {
      try {
        const [recentRes, rawRes] = await Promise.all([
          fetch("/api/memory/recent"),
          fetch("/api/memory/raw")
        ]);
        const recentData = await recentRes.json();
        const rawData = await rawRes.json();

        const recentArchs = recentData.memory?.recent_archetypes || [];
        const recentElems = recentData.memory?.recent_elements || [];

        const archEl = document.getElementById("memoryRecentArchs");
        const elemEl = document.getElementById("memoryRecentElems");
        const rawEl = document.getElementById("memoryRawContent");

        if (archEl) archEl.innerText = recentArchs.slice(0, 3).join(" ➔ ") || "Ninguno aún registrado";
        if (elemEl) elemEl.innerText = recentElems.slice(0, 4).map(e => `"${e}"`).join(", ") || "Ninguno aún registrado";
        if (rawEl) rawEl.innerText = rawData.content || "El archivo agents.md aún no tiene registros.";
      } catch (e) {
        console.error("Error refreshing memory modal:", e);
      }
    }

    async function copyToClipboard(text) {
      try {
        await navigator.clipboard.writeText(text);
        alert("✅ Copiado al portapapeles:\n\"" + text + "\"");
      } catch (e) {
        const ta = document.createElement("textarea");
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        document.body.removeChild(ta);
        alert("✅ Copiado al portapapeles:\n\"" + text + "\"");
      }
    }

    function handlePostAnalyzed(data) {
      switchTab('feed');
      const payload = {
        iteration: 1,
        timestamp: new Date().toISOString(),
        vision_data: {
          posts: [{
            author: data.author || "instagram_user",
            content_snippet: data.caption || data.summary || "",
            is_ad: false
          }],
          should_scroll: false,
          reasoning: `Publicación de @${data.author}. Tema: ${data.topic}`
        },
        text_analysis: {
          analysis: [{
            author: data.author || "instagram_user",
            topic: data.topic || "Social Media",
            sentiment: "Positive",
            action: "Like & Comment"
          }]
        }
      };
      renderAnalysisCard(payload);
    }

    // Results JSON Viewer & Export
    async function loadSavedResults() {
      const viewer = document.getElementById("jsonViewer");
      try {
        const res = await fetch("/api/results");
        const data = await res.json();
        savedResultsCache = data.results || [];
        viewer.innerText = JSON.stringify(savedResultsCache, null, 2);
      } catch (e) {
        viewer.innerText = "Error loading analysis_results.json: " + e;
      }
    }

    function downloadJsonResults() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(savedResultsCache, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", "analysis_results.json");
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // --- LOCAL AI MODEL DISCOVERY & SELECTION ---
    let localModelsCache = [];

    async function scanLocalModels(userInitiated = false) {
      const icon = document.getElementById("scanModelsIcon");
      const countLabel = document.getElementById("modelScanCount");
      const btn = document.getElementById("btnScanModels");

      if (icon) icon.classList.add("animate-spin");
      if (countLabel) countLabel.innerText = "Escaneando IAs...";
      if (btn) btn.disabled = true;

      try {
        const res = await fetch("/api/models");
        const data = await res.json();

        if (data.success && Array.isArray(data.models)) {
          localModelsCache = data.models;
          const activeV = data.active_vision_model;
          const activeT = data.active_text_model;

          renderLocalModelSelects(data.models, activeV, activeT);
          renderLocalModelCards(data.models, activeV, activeT);
          updateActiveModelLabels(activeV, activeT);

          if (countLabel) {
            countLabel.innerText = `${data.models.length} IAs detectadas en PC`;
          }
          const tsLabel = document.getElementById("modelScanTimestamp");
          if (tsLabel) {
            tsLabel.innerText = `Actualizado ${new Date().toLocaleTimeString()}`;
          }

          if (userInitiated) {
            showToast(`Se detectaron ${data.models.length} modelos de IA en tu computadora.`);
          }
        } else {
          if (countLabel) countLabel.innerText = "No se pudieron listar";
          renderEmptyModelsList();
        }
      } catch (err) {
        console.error("Error scanning local models:", err);
        if (countLabel) countLabel.innerText = "Error de conexión con Ollama";
        renderEmptyModelsList();
      } finally {
        if (icon) icon.classList.remove("animate-spin");
        if (btn) btn.disabled = false;
        lucide.createIcons();
      }
    }

    function renderLocalModelSelects(models, activeV, activeT) {
      const vSelect = document.getElementById("selectVisionModel");
      const tSelect = document.getElementById("selectTextModel");
      if (!vSelect || !tSelect) return;

      vSelect.innerHTML = "";
      tSelect.innerHTML = "";

      if (!models.length) {
        vSelect.innerHTML = '<option value="">No hay modelos en Ollama</option>';
        tSelect.innerHTML = '<option value="">No hay modelos en Ollama</option>';
        return;
      }

      // Populate Vision Select
      models.forEach(m => {
        const opt = document.createElement("option");
        opt.value = m.name;
        opt.text = `${m.name} ${m.is_vision ? '(👁️ Recomendado Visión)' : ''} [${m.size_gb} GB]`;
        if (m.name === activeV || m.name.replace(':latest', '') === (activeV || '').replace(':latest', '')) {
          opt.selected = true;
        }
        vSelect.appendChild(opt);
      });

      // Populate Text Select
      models.forEach(m => {
        const opt = document.createElement("option");
        opt.value = m.name;
        opt.text = `${m.name} ${m.is_text ? '(✍️ Recomendado Texto)' : ''} [${m.size_gb} GB]`;
        if (m.name === activeT || m.name.replace(':latest', '') === (activeT || '').replace(':latest', '')) {
          opt.selected = true;
        }
        tSelect.appendChild(opt);
      });
    }

    function renderLocalModelCards(models, activeV, activeT) {
      const container = document.getElementById("localModelsList");
      if (!container) return;

      if (!models.length) {
        renderEmptyModelsList();
        return;
      }

      container.innerHTML = "";
      models.forEach(m => {
        const isCurrentVision = (m.name === activeV || m.name.replace(':latest', '') === (activeV || '').replace(':latest', ''));
        const isCurrentText = (m.name === activeT || m.name.replace(':latest', '') === (activeT || '').replace(':latest', ''));

        const card = document.createElement("div");
        card.className = "bg-slate-950/70 border border-slate-800 hover:border-slate-700 p-2.5 rounded-xl flex flex-col space-y-2 transition";

        card.innerHTML = `
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <span class="font-mono text-xs font-semibold text-slate-200">${escapeHtml(m.name)}</span>
              <span class="text-[10px] text-slate-400 bg-slate-900 border border-slate-800 px-1.5 py-0.5 rounded font-mono">${m.size_gb} GB</span>
              ${m.param_size ? `<span class="text-[10px] text-purple-400 font-mono">${escapeHtml(m.param_size)}</span>` : ''}
            </div>
            <div class="flex items-center space-x-1">
              ${isCurrentVision ? '<span class="px-1.5 py-0.5 rounded bg-purple-900/70 border border-purple-700 text-purple-200 text-[10px] font-bold">👁️ Activo en Visión</span>' : ''}
              ${isCurrentText ? '<span class="px-1.5 py-0.5 rounded bg-sky-900/70 border border-sky-700 text-sky-200 text-[10px] font-bold">✍️ Activo en Texto</span>' : ''}
            </div>
          </div>
          <div class="flex items-center justify-between pt-1">
            <div class="flex items-center space-x-1.5 text-[10px]">
              ${m.is_vision ? '<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-purple-950/80 text-purple-300 border border-purple-800/80 font-medium">👁️ Soporta Visión</span>' : ''}
              ${m.is_text ? '<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-sky-950/80 text-sky-300 border border-sky-800/80 font-medium">✍️ Soporta Texto</span>' : ''}
            </div>
            <div class="flex items-center space-x-1.5">
              <button onclick="quickSelectModel('${escapeHtml(m.name)}', 'vision')" 
                      class="px-2 py-1 bg-purple-950/80 hover:bg-purple-900 border border-purple-800 text-purple-200 text-[10px] font-medium rounded-lg transition cursor-pointer" title="Usar este modelo para leer posts">
                Usar en Visión
              </button>
              <button onclick="quickSelectModel('${escapeHtml(m.name)}', 'text')" 
                      class="px-2 py-1 bg-sky-950/80 hover:bg-sky-900 border border-sky-800 text-sky-200 text-[10px] font-medium rounded-lg transition cursor-pointer" title="Usar este modelo para generar comentarios">
                Usar en Comentarios
              </button>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
      lucide.createIcons();
    }

    function renderEmptyModelsList() {
      const container = document.getElementById("localModelsList");
      if (container) {
        container.innerHTML = `
          <div class="text-xs text-rose-400 italic p-3 text-center border border-rose-950 rounded-xl bg-rose-950/20">
            No se detectaron modelos en Ollama. Asegúrate de tener Ollama corriendo (ollama serve).
          </div>
        `;
      }
    }

    function onModelDropdownChange() {
      const vVal = document.getElementById("selectVisionModel")?.value || "";
      const tVal = document.getElementById("selectTextModel")?.value || "";
      const engageV = document.getElementById("engageVisionLabel");
      const engageT = document.getElementById("engageTextLabel");
      if (engageV && vVal) engageV.innerText = vVal;
      if (engageT && tVal) engageT.innerText = tVal;
    }

    async function applyModelSelection() {
      const vSelect = document.getElementById("selectVisionModel");
      const tSelect = document.getElementById("selectTextModel");
      const btn = document.getElementById("btnApplyModels");

      const vision_model = vSelect ? vSelect.value : "";
      const text_model = tSelect ? tSelect.value : "";

      if (!vision_model && !text_model) {
        alert("Por favor selecciona al menos un modelo.");
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.classList.add("opacity-50");
      }

      try {
        const res = await fetch("/api/models/select", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ vision_model, text_model })
        });
        const data = await res.json();

        if (data.success) {
          updateActiveModelLabels(data.active_vision_model, data.active_text_model);
          renderLocalModelCards(localModelsCache, data.active_vision_model, data.active_text_model);
          showToast(`✅ Modelos activados: Visión: ${data.active_vision_model} • Texto: ${data.active_text_model}`);
        } else {
          alert("Error al seleccionar modelos: " + (data.error || "Desconocido"));
        }
      } catch (err) {
        alert("Error de conexión: " + err);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.classList.remove("opacity-50");
        }
      }
    }

    async function quickSelectModel(modelName, role) {
      const payload = {};
      if (role === 'vision') payload.vision_model = modelName;
      if (role === 'text') payload.text_model = modelName;
      if (role === 'both') payload.model = modelName;

      try {
        const res = await fetch("/api/models/select", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (data.success) {
          updateActiveModelLabels(data.active_vision_model, data.active_text_model);
          const vSelect = document.getElementById("selectVisionModel");
          const tSelect = document.getElementById("selectTextModel");
          if (vSelect && data.active_vision_model) vSelect.value = data.active_vision_model;
          if (tSelect && data.active_text_model) tSelect.value = data.active_text_model;

          renderLocalModelCards(localModelsCache, data.active_vision_model, data.active_text_model);
          showToast(`✅ Modelo asignado (${role}): ${modelName}`);
        }
      } catch (e) {
        console.error("Error in quickSelectModel:", e);
      }
    }

    function updateActiveModelLabels(visionModel, textModel) {
      const lblV = document.getElementById("lblActiveVision");
      const lblT = document.getElementById("lblActiveText");
      const engageV = document.getElementById("engageVisionLabel");
      const engageT = document.getElementById("engageTextLabel");

      if (lblV && visionModel) lblV.innerText = visionModel;
      if (lblT && textModel) lblT.innerText = textModel;
      if (engageV && visionModel) engageV.innerText = visionModel;
      if (engageT && textModel) engageT.innerText = textModel;
    }

    function showToast(message) {
      const toast = document.createElement("div");
      toast.className = "fixed bottom-5 right-5 z-50 bg-slate-900 border border-purple-600 text-slate-100 text-xs font-semibold px-4 py-2.5 rounded-xl shadow-2xl flex items-center space-x-2 transition-all duration-300 transform translate-y-0 opacity-100";
      toast.innerHTML = `<i data-lucide="sparkles" class="w-4 h-4 text-purple-400"></i><span>${escapeHtml(message)}</span>`;
      document.body.appendChild(toast);
      lucide.createIcons();
      setTimeout(() => {
        toast.classList.add("opacity-0", "translate-y-2");
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // --- VISUAL ICON TARGETS & TOUCH AUTOMATION ---
    let cachedIconTemplates = [];

    async function loadIconTemplates() {
      try {
        const res = await fetch("/api/icons");
        const data = await res.json();
        if (data.success) {
          cachedIconTemplates = data.templates || [];
          renderIconSelectors(cachedIconTemplates);
          renderIconGallery(cachedIconTemplates);
        }
      } catch (e) {
        console.error("Error loading icon templates:", e);
      }
    }

    function renderIconSelectors(templates) {
      const quickSelect = document.getElementById("quickIconSelect");
      const targetSelect = document.getElementById("selectedIconTarget");
      const badge = document.getElementById("templatesCountBadge");

      if (badge) badge.textContent = `${templates.length} icono${templates.length === 1 ? '' : 's'}`;

      const generateOptions = (items) => {
        if (!items || items.length === 0) {
          return `<option value="">(No hay iconos en icon_targets/)</option>`;
        }
        return items.map(t => {
          const iconEmoji = t.stem.includes("like") || t.stem.includes("heart") ? "❤️" :
                            t.stem.includes("comment") ? "💬" :
                            t.stem.includes("mas") ? "➕" :
                            t.has_red_marker ? "🔴" : "🖼️";
          const markerTag = t.has_red_marker ? " [Marcador Rojo]" : "";
          return `<option value="${t.stem}">${iconEmoji} ${t.filename}${markerTag}</option>`;
        }).join("");
      };

      if (quickSelect) quickSelect.innerHTML = generateOptions(templates);
      if (targetSelect) targetSelect.innerHTML = generateOptions(templates);
    }

    function renderIconGallery(templates) {
      const container = document.getElementById("iconGalleryGrid");
      if (!container) return;

      if (!templates || templates.length === 0) {
        container.innerHTML = `
          <div class="col-span-full py-8 text-center text-slate-500 border border-dashed border-slate-800 rounded-xl">
            <p class="text-xs">No hay iconos en icon_targets/. Sube tu primera captura arriba.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = templates.map(t => {
        const badge = t.has_red_marker
          ? `<span class="px-1.5 py-0.5 rounded-full bg-rose-950 text-rose-300 border border-rose-800 text-[9px] font-semibold flex items-center space-x-1"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span><span>Marcador Rojo</span></span>`
          : `<span class="px-1.5 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 text-[9px] font-medium">Plantilla Directa</span>`;

        return `
          <div class="bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl p-2.5 flex flex-col justify-between space-y-2 transition group">
            <div class="relative bg-slate-950 rounded-lg p-2 flex items-center justify-center h-24 overflow-hidden border border-slate-800/60">
              <img src="/api/icons/image/${encodeURIComponent(t.filename)}" alt="${escapeHtml(t.filename)}" 
                   class="max-h-full max-w-full object-contain rounded transition group-hover:scale-105">
            </div>
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-200 truncate" title="${escapeHtml(t.filename)}">${escapeHtml(t.filename)}</span>
              </div>
              <div class="flex items-center justify-between text-[10px] text-slate-500 mt-0.5">
                <span>${t.dimensions || 'N/A'}</span>
                <span>${t.size_kb} KB</span>
              </div>
              <div class="mt-1.5">
                ${badge}
              </div>
            </div>
            <button type="button" onclick="selectAndRunIcon('${t.stem}')" 
                    class="w-full py-1 px-2 bg-slate-800 hover:bg-rose-600 active:scale-95 text-slate-200 hover:text-white text-[11px] font-semibold rounded-lg border border-slate-700 hover:border-rose-500 transition flex items-center justify-center space-x-1">
              <i data-lucide="hand" class="w-3 h-3"></i>
              <span>Tocar</span>
            </button>
          </div>
        `;
      }).join("");

      lucide.createIcons();
    }

    function selectAndRunIcon(stem) {
      const select = document.getElementById("selectedIconTarget");
      if (select) select.value = stem;
      runLocateAndTap(stem);
    }

    function onTargetIconChanged() {
      // Placeholder for future preview
    }


    async function runLocateAndTap(targetName = null) {
      const iconName = targetName || document.getElementById("selectedIconTarget")?.value;
      if (!iconName) {
        alert("Por favor selecciona un icono de la lista.");
        return;
      }

      const sleepSlider = document.getElementById("iconSleepSlider");
      const sleepSec = sleepSlider ? parseFloat(sleepSlider.value) : 1.5;
      const btn = document.getElementById("locateAndTapBtn");
      const quickBtn = document.getElementById("quickTouchBtn");
      const feedback = document.getElementById("iconActionFeedback");
      const dot = document.getElementById("iconFeedbackDot");
      const text = document.getElementById("iconFeedbackText");
      const debugBtn = document.getElementById("viewDebugMatchBtn");

      if (btn) {
        btn.disabled = true;
        btn.classList.add("opacity-60");
        btn.innerHTML = `<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i><span>Localizando...</span>`;
      }
      if (quickBtn) quickBtn.disabled = true;

      if (feedback) {
        feedback.className = "rounded-lg p-2.5 text-xs flex items-center justify-between border bg-slate-900/90 border-slate-700 text-slate-300";
        feedback.classList.remove("hidden");
        if (dot) dot.className = "w-2 h-2 rounded-full bg-amber-400 animate-pulse";
        if (text) text.textContent = `Buscando icono '${iconName}' en pantalla...`;
        if (debugBtn) debugBtn.classList.add("hidden");
      }
      lucide.createIcons();

      try {
        const res = await fetch("/api/icons/locate-and-tap", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            icon_name: iconName,
            sleep_seconds: sleepSec,
            vision_model: document.getElementById("selectVisionModel")?.value || document.getElementById("lblActiveVision")?.innerText || "qwen2.5vl:latest"
          })
        });
        const data = await res.json();

        if (data.success && data.result?.found) {
          const r = data.result;
          const coords = `(${r.center[0]}, ${r.center[1]})`;
          const conf = Math.round(r.confidence * 100);
          if (feedback) {
            feedback.className = "rounded-lg p-2.5 text-xs flex items-center justify-between border bg-emerald-950/50 border-emerald-800 text-emerald-300";
            if (dot) dot.className = "w-2 h-2 rounded-full bg-emerald-400";
            if (text) text.textContent = `¡Toque realizado en ${coords}! • Coincidencia: ${conf}% (${r.method}) • Pausa: ${r.sleep_after}s`;
            if (debugBtn && r.debug_image) {
              debugBtn.classList.remove("hidden");
            }
          }
          showToast(`🎯 Icono '${iconName}' tocado en ${coords}`);
          refreshScreen();
        } else {
          if (feedback) {
            feedback.className = "rounded-lg p-2.5 text-xs flex items-center justify-between border bg-rose-950/50 border-rose-800 text-rose-300";
            if (dot) dot.className = "w-2 h-2 rounded-full bg-rose-400";
            if (text) text.textContent = `No se localizó el icono '${iconName}' en la pantalla activa.`;
          }
          showToast(`⚠️ Icono '${iconName}' no encontrado en pantalla`);
        }
      } catch (err) {
        if (feedback) {
          feedback.className = "rounded-lg p-2.5 text-xs flex items-center justify-between border bg-rose-950/50 border-rose-800 text-rose-300";
          if (dot) dot.className = "w-2 h-2 rounded-full bg-rose-400";
          if (text) text.textContent = `Error: ${err.message}`;
        }
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.classList.remove("opacity-60");
          btn.innerHTML = `<i data-lucide="crosshair" class="w-3.5 h-3.5"></i><span>Buscar y Tocar</span>`;
        }
        if (quickBtn) quickBtn.disabled = false;
        lucide.createIcons();
      }
    }

    async function handleIconUpload(event) {
      event.preventDefault();
      const fileInput = document.getElementById("iconFileInput");
      const nameInput = document.getElementById("iconTemplateNameInput");
      const btn = document.getElementById("uploadIconBtn");

      if (!fileInput.files || fileInput.files.length === 0) {
        alert("Por favor selecciona un archivo de imagen.");
        return;
      }

      const formData = new FormData();
      formData.append("file", fileInput.files[0]);
      if (nameInput && nameInput.value.trim()) {
        formData.append("template_name", nameInput.value.trim());
      }

      btn.disabled = true;
      btn.innerHTML = `<i data-lucide="loader-2" class="w-3 h-3 animate-spin"></i><span>Subiendo...</span>`;
      lucide.createIcons();

      try {
        const res = await fetch("/api/icons/upload", {
          method: "POST",
          body: formData
        });
        const data = await res.json();
        if (data.success) {
          showToast(`✅ ${data.message}`);
          fileInput.value = "";
          if (nameInput) nameInput.value = "";
          loadIconTemplates();
        } else {
          alert("Error al subir imagen: " + (data.error || "Desconocido"));
        }
      } catch (e) {
        alert("Error al subir archivo: " + e.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<i data-lucide="upload" class="w-3 h-3"></i><span>Subir</span>`;
        lucide.createIcons();
      }
    }

    function toggleDebugMatchModal() {
      const modal = document.getElementById("debugMatchModal");
      const img = document.getElementById("debugMatchImg");
      if (!modal) return;
      if (modal.classList.contains("hidden")) {
        if (img) img.src = `/api/icons/debug-image?t=${Date.now()}`;
        modal.classList.remove("hidden");
      } else {
        modal.classList.add("hidden");
      }
    }
  </script>
</body>
</html>
