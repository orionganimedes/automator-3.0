      const accountsToUse = parseInt(document.getElementById("accountsToUseInput")?.value) || 1;
      const narrative = document.getElementById("cycleNarrativeSelect")?.value || "a_favor";
      const tone = document.getElementById("cycleToneSelect")?.value || "auto";
      const customComment = document.getElementById("cycleCustomComment")?.value.trim() || "";
      const visionModel = document.getElementById("selectVisionModel")?.value || "";
      const textModel = document.getElementById("selectTextModel")?.value || "";

      if (!doLike && !doComment) {
        alert("Selecciona al menos una acción: Dar Like o Comentar con IA.");
        return;
      }

      // Contexto de la Publicación: se usa directamente lo ingresado en el campo manual
      const manualContext = document.getElementById("manualContextPostText")?.value.trim() || "";
      const isContest = document.getElementById("manualContextIsContest")?.checked ?? false;
      const contestRequirement = document.getElementById("manualContextContestReq")?.value.trim() || "";
      const teamsOrTopic = document.getElementById("manualContextContestTopic")?.value.trim() || "";
      const mediaType = document.getElementById("mediaTypeInput")?.value || "post";

      // Modo de comentarios y banco de comentarios pegados
      const commentMode = document.getElementById("selectedCommentMode")?.value || "auto";
      const pastedComments = (document.getElementById("pastedCommentsTextarea")?.value || "")
        .split("\n").map(s => s.trim()).filter(Boolean);

      if (doComment && commentMode === "preset_list" && pastedComments.length === 0) {
        alert("Has seleccionado el Modo 'Lista Predefinida', pero tu banco de comentarios pegados está vacío. Por favor pega tus comentarios en la pestaña 'Comentarios & Análisis' a la derecha o selecciona 'Modo Autónomo IA'.");
        switchTab('comments');
        document.getElementById("pastedCommentsTextarea")?.focus();
        return;
      }

      if (startManualBtn) {
        startManualBtn.disabled = true;
        startManualBtn.classList.add("opacity-50", "cursor-not-allowed");
      }
      if (startCycleBtn) {
        startCycleBtn.disabled = true;
        startCycleBtn.classList.add("opacity-50", "cursor-not-allowed");
      }
      if (stopBtn) {
        stopBtn.disabled = false;
        stopBtn.classList.remove("opacity-30", "cursor-not-allowed");
      }

      document.getElementById("cycleErrorAlert")?.classList.add("hidden");
      document.getElementById("cycleCommentBox")?.classList.add("hidden");
      const statusWidget = document.getElementById("cycleStatusWidget");
      if (statusWidget) statusWidget.classList.remove("hidden");

      const badge = document.getElementById("cycleAccountBadge");
      const stepNum = document.getElementById("cycleStepNum");
      const stepMsg = document.getElementById("cycleStepMsg");
      const progressBar = document.getElementById("cycleProgressBar");

      const postLabel = mediaType === "reel" ? "Reel" : "publicación";
      if (badge) badge.innerText = `Cuenta 1 de ${accountsToUse}`;
      if (stepNum) stepNum.innerText = "Paso 1";
      if (stepMsg) stepMsg.innerText = `Abriendo ${postLabel} directamente en el teléfono...`;
      if (progressBar) progressBar.style.width = "10%";

      try {
        const res = await fetch("/api/manual-automation/start", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            url: url,
            media_type: mediaType,
            package_name: packageName,
            use_current_screen: useCurrentScreen,
            do_like: doLike,
            do_comment: doComment,
            repeat_cycles: repeatCycles,
            cycle_count: cycleCount,
            max_cycles: cycleCount,
            accounts_to_use: accountsToUse,
            narrative: narrative,
            tone: tone,
            custom_comment: customComment,
            vision_model: visionModel,
            text_model: textModel,
            manual_context: manualContext,
            is_contest: isContest,
            contest_requirement: contestRequirement,
            teams_or_topic: teamsOrTopic,
            comment_mode: commentMode,
            pasted_comments: pastedComments
          })
        });

        const data = await res.json();
        if (!data.success) {
          handleCycleError({ error: data.error || data.message || "Error al iniciar la automatización manual." });
        }
      } catch (e) {
        handleCycleError({ error: "Error de red o conexión al servidor: " + e });
      }
    }

    async function stopMultiAccountCycle() {
      const startBtn = document.getElementById("btnStartCycle");
      const startManualBtn = document.getElementById("btnStartManual");
      const stopBtn = document.getElementById("btnStopCycle");
      const stepMsg = document.getElementById("cycleStepMsg");
      const stepNum = document.getElementById("cycleStepNum");
      const badge = document.getElementById("cycleAccountBadge");
      const spinner = document.getElementById("cycleSpinner");
      const bar = document.getElementById("cycleProgressBar");

      // Immediate UI update directly on frontend
      if (stopBtn) {
        stopBtn.disabled = true;
        stopBtn.classList.add("opacity-30", "cursor-not-allowed");
      }
      if (startBtn) {
        startBtn.disabled = false;
        startBtn.classList.remove("opacity-50", "cursor-not-allowed");
      }
      if (startManualBtn) {
        startManualBtn.disabled = false;
        startManualBtn.classList.remove("opacity-50", "cursor-not-allowed");
      }
      if (badge) badge.innerText = "Detenido ⏹️";
      if (stepNum) stepNum.innerText = "Detenido";
      if (stepMsg) stepMsg.innerText = "Deteniendo automatización y regresando a la pantalla de inicio...";
      if (spinner) spinner.classList.add("hidden");
      if (bar) bar.style.width = "0%";

      try {
        await fetch("/api/cycle/stop", { method: "POST" });
      } catch (e) {
        console.error("Error solicitando detención:", e);
      }
    }

    function handleCycleStep(data) {
      const statusWidget = document.getElementById("cycleStatusWidget");
      const badge = document.getElementById("cycleAccountBadge");
      const num = document.getElementById("cycleStepNum");
      const msg = document.getElementById("cycleStepMsg");
      const bar = document.getElementById("cycleProgressBar");
      const startBtn = document.getElementById("btnStartCycle");
      const startManualBtn = document.getElementById("btnStartManual");
      const stopBtn = document.getElementById("btnStopCycle");
      const spinner = document.getElementById("cycleSpinner");

      if (statusWidget) statusWidget.classList.remove("hidden");

      if (data.is_error || data.step === -1) {
        handleCycleError({ error: data.message });
        return;
      }

      if (data.total_accounts && data.account_idx) {
        badge.innerText = `Cuenta ${data.account_idx} de ${data.total_accounts}`;
      } else if (data.total_accounts) {
        badge.innerText = `${data.total_accounts} cuentas detectadas`;
      }

      if (msg) msg.innerText = data.message || "";

      if (data.step === 100) {
        if (num) num.innerText = "¡Completado! 🎉";
        if (bar) bar.style.width = "100%";
        if (startBtn) {
          startBtn.disabled = false;
          startBtn.classList.remove("opacity-50", "cursor-not-allowed");
        }
        if (startManualBtn) {
          startManualBtn.disabled = false;
          startManualBtn.classList.remove("opacity-50", "cursor-not-allowed");
        }
        if (stopBtn) {
          stopBtn.disabled = true;
          stopBtn.classList.add("opacity-30", "cursor-not-allowed");
        }
        if (spinner) spinner.classList.add("hidden");
      } else if (data.step === 99) {
        if (badge) badge.innerText = "Detenido ⏹️";
        if (num) num.innerText = "Detenido";
        if (bar) bar.style.width = "0%";
        if (msg) msg.innerText = data.message || "Automatización detenida. El teléfono regresó a la pantalla principal.";
        if (startBtn) {
          startBtn.disabled = false;
          startBtn.classList.remove("opacity-50", "cursor-not-allowed");
        }
        if (startManualBtn) {
          startManualBtn.disabled = false;
          startManualBtn.classList.remove("opacity-50", "cursor-not-allowed");
        }
        if (stopBtn) {
          stopBtn.disabled = true;
          stopBtn.classList.add("opacity-30", "cursor-not-allowed");
        }
        if (spinner) spinner.classList.add("hidden");
      } else {
        if (num) num.innerText = `Paso ${data.step}/16`;
        const pct = Math.min(95, Math.max(5, Math.round((data.step / 16) * 100)));
        if (bar) bar.style.width = `${pct}%`;
        if (spinner) spinner.classList.remove("hidden");
      }

      lucide.createIcons();
    }

    function handleCycleError(data) {
      const alertBox = document.getElementById("cycleErrorAlert");
      const errorMsg = document.getElementById("cycleErrorMsg");
      const startBtn = document.getElementById("btnStartCycle");
      const startManualBtn = document.getElementById("btnStartManual");
      const stopBtn = document.getElementById("btnStopCycle");
      const spinner = document.getElementById("cycleSpinner");
      const stepNum = document.getElementById("cycleStepNum");

      if (alertBox) alertBox.classList.remove("hidden");
      if (errorMsg) errorMsg.innerText = data.error || "Ocurrió un fallo en el proceso de automatización.";
      if (stepNum) stepNum.innerText = "Error ❌";
      if (spinner) spinner.classList.add("hidden");

      if (startBtn) {
        startBtn.disabled = false;
        startBtn.classList.remove("opacity-50", "cursor-not-allowed");
      }
      if (startManualBtn) {
        startManualBtn.disabled = false;
        startManualBtn.classList.remove("opacity-50", "cursor-not-allowed");
      }
      if (stopBtn) {
        stopBtn.disabled = true;
        stopBtn.classList.add("opacity-30", "cursor-not-allowed");
      }

      lucide.createIcons();
    }

    // Dynamic Account Scanner
    async function scanDeviceAccounts() {
      const btn = document.getElementById("btnScanAccounts");
      const label = document.getElementById("accountsLimitLabel");
      const input = document.getElementById("accountsToUseInput");
      if (btn) {
        btn.disabled = true;
        btn.classList.add("opacity-50");
      }
      if (label) label.innerText = "Escaneando...";
      try {
        const res = await fetch("/api/accounts/scan");
        const data = await res.json();
        if (data.success) {
          if (label) label.innerText = `Total detectadas: ${data.total_accounts}`;
          if (input && (!input.value || input.value === "0")) {
            input.value = data.total_accounts;
          }
          if (input) input.max = Math.max(1, data.total_accounts);
        } else {
          if (label) label.innerText = "Error: " + (data.error || "Desconocido");
        }
      } catch (e) {
        if (label) label.innerText = "Error de red: " + e;
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.classList.remove("opacity-50");
        }
      }
    }

    // Screenshot Cache Cleaner
    async function clearScreenshots() {
      const btn = document.getElementById("btnClearScreenshots");
      const text = document.getElementById("clearText");
      if (btn) {
        btn.disabled = true;
        btn.classList.add("opacity-50");
      }
      if (text) text.innerText = "...";
      try {
        const res = await fetch("/api/screenshots/clear", { method: "POST" });
        const data = await res.json();
        if (data.success) {
          alert(`🧹 Limpieza completada:\n• ${data.deleted_count} capturas residuales eliminadas\n• ${data.freed_mb} MB de espacio liberado`);
        } else {
          alert("Error al limpiar capturas: " + (data.error || "Desconocido"));
        }
      } catch (e) {
        alert("Error de red: " + e);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.classList.remove("opacity-50");
        }
        if (text) text.innerText = "Limpiar";
      }
    }

    function toggleManualContextContestFields(show) {
      const fields = document.getElementById("manualContextContestFields");
      if (fields) {
        if (show) fields.classList.remove("hidden");
        else fields.classList.add("hidden");
      }
    }

    function pasteExampleContestContext() {
      const textarea = document.getElementById("manualContextPostText");
      if (textarea) {
        textarea.value = `🐯🔥 ¿QUIÉN QUIERE ESTA JERSEY DE TIGRES AUTOGRAFIADA? 🔥🐯\nQuiero que alguien la estrene mañana para el Clásico Regio 143. 👀\nParticipar es muy fácil:\n1️⃣ Sígueme.\n2️⃣ Comenta tu pronóstico para el Clásico Regio 143. ⚽️\n3️⃣ Comparte esta publicación en tus historias y etiquétame. 📲\n🏆 El ganador se dará a conocer HOY a las 10:00 PM.\n¿Quién se la lleva? 👀🐯`;
      }
      const contestCheck = document.getElementById("manualContextIsContest");
      if (contestCheck) {
        contestCheck.checked = true;
        toggleManualContextContestFields(true);
      }
