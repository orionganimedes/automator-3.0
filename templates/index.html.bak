<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Local AI Android Automator - Control Dashboard</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              500: '#0284c7',
              600: '#0369a1',
              700: '#075985',
              900: '#0c4a6e',
            }
          }
        }
      }
    }
  </script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    /* Custom scrollbar for terminal & feeds */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans flex flex-col">

  <!-- TOP NAVIGATION HEADER -->
  <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur px-6 py-3 flex items-center justify-between sticky top-0 z-50">
    <div class="flex items-center space-x-3">
      <div class="p-2 bg-gradient-to-tr from-sky-600 to-indigo-600 rounded-xl shadow-lg shadow-sky-500/20">
        <i data-lucide="smartphone" class="w-6 h-6 text-white"></i>
      </div>
      <div>
        <h1 class="text-lg font-bold bg-gradient-to-r from-sky-400 to-indigo-300 bg-clip-text text-transparent">
          Android AI Automator
        </h1>
        <p class="text-xs text-slate-400">Local Vision & Sentiment Pipeline</p>
      </div>
    </div>

    <!-- STATUS BADGES -->
    <div class="flex items-center space-x-3">
      <!-- ADB Device Status -->
      <div id="deviceBadge" class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-slate-800/80 border border-slate-700 text-xs text-slate-300">
        <span id="deviceDot" class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span id="deviceText">Checking ADB...</span>
      </div>

      <!-- Ollama Status -->
      <div id="ollamaBadge" class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-slate-800/80 border border-slate-700 text-xs text-slate-300">
        <span id="ollamaDot" class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span id="ollamaText">Checking Ollama...</span>
      </div>

      <!-- Automation State Badge -->
      <div id="stateBadge" class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-slate-800/80 border border-slate-700 text-xs font-semibold uppercase tracking-wider text-slate-300">
        <span id="stateDot" class="w-2.5 h-2.5 rounded-full bg-slate-500"></span>
        <span id="stateText">IDLE</span>
      </div>
    </div>
  </header>

  <!-- MAIN DASHBOARD CONTENT -->
  <main class="flex-1 p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-[1700px] w-full mx-auto">

    <!-- LEFT COLUMN: DEVICE CONTROLLER & SCREEN PREVIEW (5 COLS) -->
    <div class="lg:col-span-5 flex flex-col space-y-6">

      <!-- PHONE SCREEN CONTAINER -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center space-x-2">
            <i data-lucide="cast" class="w-5 h-5 text-sky-400"></i>
            <h2 class="font-semibold text-slate-200">Device Screen</h2>
          </div>
          <div class="flex items-center space-x-3 text-xs text-slate-400">
            <label class="flex items-center space-x-1.5 cursor-pointer" title="Transmisión fluida de pantalla en tiempo real">
              <input type="checkbox" id="autoRefreshToggle" class="rounded bg-slate-800 border-slate-700 text-emerald-500 focus:ring-emerald-500" checked>
              <span class="text-emerald-400 font-semibold text-[11px]">Stream en Vivo</span>
            </label>
            <button onclick="takeManualCapture()" class="p-1.5 hover:bg-slate-800 rounded-lg transition" title="Tomar captura manual">
              <i data-lucide="refresh-cw" class="w-4 h-4 text-slate-300"></i>
            </button>
          </div>
        </div>

        <!-- SCREEN DISPLAY WRAPPER -->
        <div class="relative bg-slate-950 border border-slate-800/80 rounded-xl overflow-hidden flex items-center justify-center min-h-[460px] max-h-[520px]">
          <!-- Real-Time Stream Badge -->
          <div class="absolute top-3 right-3 z-10 flex items-center space-x-1.5 bg-slate-950/80 backdrop-blur-md border border-emerald-500/40 px-2.5 py-1 rounded-full text-[11px] font-semibold text-emerald-400 shadow-lg">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span>EN VIVO</span>
          </div>

          <img id="deviceScreen" src="/api/device/stream" alt="Device Screen" 
               class="h-full max-h-[500px] w-auto object-contain rounded-lg shadow-2xl transition duration-200"
               onerror="onScreenLoadError(this)" onload="onScreenLoadSuccess(this)">
          
          <div id="screenPlaceholder" class="hidden absolute flex flex-col items-center justify-center text-slate-500 p-6 text-center">
            <i data-lucide="smartphone-charging" class="w-12 h-12 mb-2 text-slate-600"></i>
            <p class="text-sm font-medium">Conectando con la pantalla del dispositivo...</p>
            <p class="text-xs mt-1 text-slate-600">Asegúrate de que ADB esté conectado y presiona "Captura"</p>
          </div>

          <!-- Spinner Overlay -->
          <div id="screenSpinner" class="hidden absolute inset-0 bg-slate-950/40 backdrop-blur-xs flex items-center justify-center">
            <i data-lucide="loader-2" class="w-8 h-8 text-sky-400 animate-spin"></i>
          </div>
        </div>

        <!-- QUICK TOUCH / NAVIGATION CONTROLS -->
        <div class="grid grid-cols-4 gap-2 mt-4">
          <button onclick="manualScroll('up')" class="flex items-center justify-center space-x-1 py-2 px-2 bg-slate-800 hover:bg-slate-700 active:scale-98 text-slate-200 text-xs font-medium rounded-xl border border-slate-700 transition">
            <i data-lucide="chevron-up" class="w-3.5 h-3.5 text-sky-400"></i>
            <span>Arriba</span>
          </button>
          <button onclick="takeManualCapture()" class="flex items-center justify-center space-x-1 py-2 px-2 bg-slate-800 hover:bg-slate-700 active:scale-98 text-slate-200 text-xs font-medium rounded-xl border border-slate-700 transition" title="Tomar captura fresca">
            <i data-lucide="camera" class="w-3.5 h-3.5 text-amber-400"></i>
            <span>Captura</span>
          </button>
          <button onclick="manualScroll('down')" class="flex items-center justify-center space-x-1 py-2 px-2 bg-slate-800 hover:bg-slate-700 active:scale-98 text-slate-200 text-xs font-medium rounded-xl border border-slate-700 transition">
            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-sky-400"></i>
            <span>Abajo</span>
          </button>
          <button onclick="clearScreenshots()" id="btnClearScreenshots" class="flex items-center justify-center space-x-1 py-2 px-2 bg-rose-950/40 hover:bg-rose-900/60 active:scale-98 text-rose-300 text-xs font-medium rounded-xl border border-rose-800/60 transition" title="Eliminar capturas de pantalla residuales">
            <i data-lucide="trash-2" class="w-3.5 h-3.5 text-rose-400" id="clearIcon"></i>
            <span id="clearText">Limpiar</span>
          </button>
        </div>
      </div>

      <!-- AUTOMATION CONTROLS PANEL -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl flex flex-col space-y-4">
        <div class="flex items-center space-x-2">
          <i data-lucide="sliders" class="w-5 h-5 text-indigo-400"></i>
          <h2 class="font-semibold text-slate-200">Automation Settings</h2>
        </div>

        <!-- App Preset & Package Name -->
        <div class="space-y-1.5">
          <label class="text-xs font-medium text-slate-400 flex items-center justify-between">
            <span>Target Application</span>
            <span class="text-[10px] text-amber-400 font-mono font-bold">Por defecto: Instagram Lite</span>
          </label>
          <div class="grid grid-cols-4 gap-1.5">
            <button type="button" onclick="setAppPackage('com.instagram.lite')" class="preset-btn py-1.5 px-1 bg-amber-950/70 hover:bg-amber-800 border border-amber-500/80 rounded-lg text-[11px] font-bold text-amber-300 text-center transition shadow-sm" title="Instagram Lite (App recomendada)">
              ⚡ IG Lite
            </button>
            <button type="button" onclick="setAppPackage('com.instagram.android')" class="preset-btn py-1.5 px-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-[11px] font-medium text-slate-200 text-center transition">
              Instagram
            </button>
            <button type="button" onclick="setAppPackage('com.facebook.katana')" class="preset-btn py-1.5 px-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-[11px] font-medium text-slate-200 text-center transition">
              Facebook
            </button>
            <button type="button" onclick="setAppPackage('com.instagram.barcelona')" class="preset-btn py-1.5 px-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-[11px] font-medium text-slate-200 text-center transition">
              Threads
            </button>
          </div>
          <div class="flex space-x-2 mt-2">
            <input type="text" id="packageNameInput" value="com.instagram.lite" 
                   class="flex-1 bg-slate-950 border border-amber-500/50 rounded-xl px-3 py-2 text-xs text-amber-200 focus:outline-none focus:border-amber-400 font-mono" 
                   placeholder="Package name (e.g. com.instagram.lite)">
            <button onclick="launchTargetApp()" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs rounded-xl border border-slate-700 transition" title="Launch on device">
              <i data-lucide="play-circle" class="w-4 h-4 text-emerald-400"></i>
            </button>
          </div>
        </div>

        <!-- MULTI-ACCOUNT CYCLE AUTOMATION (FROM POST LINK) -->
        <div class="space-y-3 pt-3 border-t border-slate-800/80 bg-slate-950/40 p-3.5 rounded-xl border border-amber-500/20 shadow-inner">
          <div class="flex items-center justify-between">
            <label class="text-xs font-semibold text-slate-200 flex items-center space-x-2">
              <div class="p-1 bg-gradient-to-r from-amber-500 to-rose-500 rounded-md">
                <i data-lucide="link" class="w-3.5 h-3.5 text-slate-950"></i>
              </div>
              <span>Abrir Enlace en el Teléfono</span>
            </label>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-950/80 text-amber-400 border border-amber-800/60 font-medium">Ciclo Multi-Cuenta</span>
          </div>

          <p class="text-[11px] text-slate-400 leading-tight">
            Inicia el ciclo automático rotando por todas las cuentas registradas en el dispositivo a partir de esta publicación.
          </p>

          <!-- URL Input & Quick Open -->
          <div class="space-y-1.5">
            <div class="flex space-x-2">
              <input type="text" id="urlInput" 
                     class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-amber-500 placeholder-slate-600 font-mono" 
                     placeholder="https://www.instagram.com/p/... o /reel/...">
              <button onclick="openUrlOnDevice()" id="openUrlBtn" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 active:scale-98 text-slate-300 font-medium text-xs rounded-xl flex items-center space-x-1.5 border border-slate-700 transition" title="Abrir enlace únicamente">
                <i data-lucide="external-link" class="w-3.5 h-3.5 text-amber-400"></i>
                <span>Abrir</span>
              </button>
            </div>

            <!-- Selector de Tipo de Contenido: Post vs Reel -->
            <div class="flex items-center justify-between bg-slate-950/70 border border-slate-800/80 rounded-xl px-2.5 py-1.5">
              <span class="text-[11px] font-medium text-slate-400 flex items-center space-x-1.5">
                <span>Tipo de contenido:</span>
              </span>
              <div class="inline-flex p-0.5 bg-slate-900 border border-slate-800 rounded-lg text-xs" id="mediaTypeToggleGroup">
                <button type="button" id="btnMediaTypePost" onclick="setMediaType('post')" 
                        class="px-2.5 py-1 rounded-md font-semibold text-[11px] transition flex items-center space-x-1 bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-sm" title="Publicación estándar (fotos / carrusel)">
                  <span>📷 Post</span>
                </button>
                <button type="button" id="btnMediaTypeReel" onclick="setMediaType('reel')" 
                        class="px-2.5 py-1 rounded-md font-semibold text-[11px] transition flex items-center space-x-1 text-slate-400 hover:text-slate-200 border border-transparent" title="Reel de Instagram (video vertical con iconos en carril derecho)">
                  <span>🎬 Reel</span>
                </button>
              </div>
              <input type="hidden" id="mediaTypeInput" value="post">
            </div>

            <label class="flex items-center space-x-2 text-[11px] text-slate-400 hover:text-slate-200 cursor-pointer select-none pt-0.5">
              <input type="checkbox" id="cycleUseCurrentScreen" class="rounded bg-slate-800 border-slate-700 text-amber-500 focus:ring-amber-500">
              <span class="flex items-center space-x-1">
                <span>📱</span>
                <span>Usar publicación actual en pantalla (no reabrir enlace)</span>
              </span>
            </label>
          </div>

          <!-- Actions Checkboxes -->
          <div class="grid grid-cols-2 gap-2 pt-1 text-xs">
            <label class="flex items-center space-x-2 text-slate-300 cursor-pointer bg-slate-900/90 border border-slate-800/80 p-2 rounded-lg">
              <input type="checkbox" id="cycleDoLike" checked class="rounded bg-slate-800 border-slate-700 text-rose-500 focus:ring-rose-500">
              <span class="text-[11px] font-medium flex items-center space-x-1">
                <i data-lucide="heart" class="w-3 h-3 text-rose-400"></i>
                <span>Dar Like</span>
              </span>
            </label>
            <label class="flex items-center space-x-2 text-slate-300 cursor-pointer bg-slate-900/90 border border-slate-800/80 p-2 rounded-lg">
              <input type="checkbox" id="cycleDoComment" checked class="rounded bg-slate-800 border-slate-700 text-sky-500 focus:ring-sky-500">
              <span class="text-[11px] font-medium flex items-center space-x-1">
                <i data-lucide="message-square" class="w-3 h-3 text-sky-400"></i>
                <span>Comentar IA</span>
              </span>
            </label>
          </div>

          <!-- Bot Contador de Cuentas & Selección -->
          <div class="bg-slate-900/90 border border-slate-800 p-2.5 rounded-xl space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-slate-300 text-[11px] font-semibold flex items-center space-x-1.5">
                <i data-lucide="bot" class="w-3.5 h-3.5 text-indigo-400"></i>
                <span>1. Bot Contador de Cuentas:</span>
              </span>
              <button type="button" onclick="scanDeviceAccounts()" id="btnScanAccounts" class="px-2.5 py-1 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-semibold text-[11px] rounded-lg flex items-center space-x-1 transition shadow cursor-pointer" title="Inspecciona el teléfono para saber cuántas cuentas hay registradas">
                <i data-lucide="search" class="w-3 h-3 text-white" id="scanAccountsIcon"></i>
                <span id="scanAccountsText">Saber cuántas cuentas hay</span>
              </button>
            </div>
            <div class="flex items-center justify-between text-xs pt-0.5">
              <span class="text-slate-400 text-[11px]">2. Cuentas que deseas usar:</span>
              <div class="flex items-center space-x-1.5">
                <input type="number" id="accountsToUseInput" min="1" max="100" value="1" 
                       class="w-14 bg-slate-950 border border-slate-700 text-center text-xs text-indigo-400 font-bold rounded-lg px-2 py-1 focus:outline-none focus:border-indigo-500">
                <span class="text-[10px] text-slate-400" id="accountsLimitLabel">cuentas</span>
              </div>
            </div>
          </div>

          <!-- Iterations / Cycles Selector -->
          <div class="flex items-center justify-between text-xs pt-1">
            <span class="text-slate-400 text-[11px] font-medium flex items-center space-x-1">
              <i data-lucide="repeat" class="w-3.5 h-3.5 text-amber-400"></i>
              <span>Veces a ejecutar (Ciclos):</span>
            </span>
            <div class="flex items-center space-x-1.5">
              <input type="number" id="cycleCountInput" min="1" max="100" value="1" 
                     class="w-16 bg-slate-950 border border-slate-800 text-center text-xs text-amber-400 font-bold rounded-lg px-2 py-1 focus:outline-none focus:border-amber-500">
              <span class="text-[10px] text-slate-500">vuelta(s)</span>
            </div>
          </div>

          <!-- Narrative Stance Selector -->
          <div class="flex items-center justify-between text-xs pt-1">
            <span class="text-slate-400 text-[11px] font-medium flex items-center space-x-1">
              <i data-lucide="target" class="w-3.5 h-3.5 text-rose-400"></i>
              <span>Narrativa / Postura:</span>
            </span>
            <select id="cycleNarrativeSelect" class="bg-slate-950 border border-slate-800 text-[11px] text-slate-200 rounded-lg px-2 py-1 focus:outline-none focus:border-rose-500 max-w-[210px]">
              <option value="a_favor" selected>👍 A favor / Apoyo entusiasta</option>
              <option value="participacion">💬 De participación / Pregunta</option>
              <option value="hate">⚡ Crítico / Hate / Desacuerdo</option>
              <option value="neutro">⚖️ Neutro / Observación</option>
            </select>
          </div>

          <!-- Shortcut to Simulator Tab -->
          <button type="button" onclick="switchTab('sim')" 
                  class="w-full py-1.5 px-3 bg-amber-950/30 hover:bg-amber-900/50 border border-amber-800/50 text-amber-300 text-[11px] rounded-lg flex items-center justify-center space-x-1.5 transition cursor-pointer">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i>
            <span>🧪 Probar y simular comentarios con narrativa</span>
          </button>

          <!-- Archetype Regiomontano Selector -->
          <div class="flex items-center justify-between text-xs pt-1">
            <span class="text-slate-400 text-[11px] font-medium flex items-center space-x-1">
              <span>🧠</span>
              <span>Arquetipo / Sistema:</span>
            </span>
            <select id="cycleToneSelect" class="bg-slate-950 border border-slate-800 text-[11px] text-slate-200 rounded-lg px-2 py-1 focus:outline-none focus:border-amber-500 max-w-[210px]">
              <optgroup label="✨ Arquetipos Humanos (agents.md)">
                <option value="auto" selected>✨ Humano Inteligente (Memoria agents.md)</option>
                <option value="Testigo Silencioso">👁️ Testigo Silencioso</option>
                <option value="Buscador">🔍 Buscador</option>
                <option value="Guerrero Interior">⚔️ Guerrero Interior</option>
                <option value="Caminante">🚶 Caminante</option>
                <option value="Heredero">🏛️ Heredero</option>
              </optgroup>
              <optgroup label="🤠 Arquetipos Regionales Regiomontanos">
                <option value="1">1. El Escéptico ("Chale")</option>
                <option value="2">2. El Animador Leal ("Fierro")</option>
                <option value="3">3. El Consejero ("Morro")</option>
                <option value="4">4. El Realista ("Está cañón")</option>
                <option value="5">5. El Guardián ("Ponte trucha")</option>
                <option value="6">6. El Auténtico ("La neta")</option>
              </optgroup>
            </select>
          </div>

          <!-- CONTEXTO DE LA PUBLICACIÓN Y ANÁLISIS PREVIO -->
          <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-amber-950/30 border border-amber-500/40 p-3 rounded-2xl space-y-3 shadow-lg">
            <div class="flex items-center justify-between pb-1 border-b border-slate-800">
              <div class="flex items-center space-x-2">
                <div class="p-1.5 bg-amber-500/20 text-amber-400 rounded-lg border border-amber-500/30">
                  <i data-lucide="file-text" class="w-4 h-4"></i>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-100 flex items-center space-x-1.5">
                    <span>Contexto de la Publicación</span>
                    <span class="text-[9px] px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 font-mono">Paso Previo</span>
                  </h4>
                  <p class="text-[10px] text-slate-400">Analiza de qué trata y previsualiza qué comentará antes de automatizar</p>
                </div>
              </div>
              <div class="flex items-center space-x-1.5 flex-wrap gap-y-1">
                <button type="button" onclick="captureAndReadScreen()" id="btnCaptureScreen" 
                        class="px-2.5 py-1 bg-gradient-to-r from-sky-600 to-cyan-600 hover:from-sky-500 hover:to-cyan-500 text-white font-semibold text-[10px] rounded-lg flex items-center space-x-1 shadow-sm shadow-sky-500/20 transition cursor-pointer" 
                        title="Toma una captura de pantalla del teléfono vía ADB y transcribe el texto con IA">
                  <i data-lucide="camera" class="w-3 h-3 text-white"></i>
                  <span id="btnCaptureScreenText">📸 Capturar y Leer Pantalla</span>
                </button>
                <label class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-[10px] font-medium rounded-lg flex items-center space-x-1 transition cursor-pointer" title="Subir imagen de captura desde la computadora">
                  <i data-lucide="upload" class="w-3 h-3 text-slate-400"></i>
                  <span>Subir captura</span>
                  <input type="file" id="uploadScreenInput" accept="image/*" class="hidden" onchange="uploadAndReadScreen(this)">
                </label>
                <button type="button" onclick="pasteExampleContestContext()" 
                        class="px-2 py-1 bg-amber-950/60 hover:bg-amber-900 text-amber-300 border border-amber-800 text-[10px] font-medium rounded-lg flex items-center space-x-1 transition cursor-pointer" title="Carga un ejemplo de publicación con dinámica">
                  <i data-lucide="sparkles" class="w-3 h-3 text-amber-400"></i>
                  <span>Ejemplo</span>
                </button>
                <button type="button" onclick="clearManualContext()" 
                        class="p-1 hover:bg-slate-800 text-slate-400 hover:text-rose-400 rounded-lg transition cursor-pointer" title="Limpiar contexto">
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </div>

            <!-- Mini Card: Previsualización de Captura Tomada / Subida -->
            <div id="capturedScreenPreviewCard" class="hidden bg-slate-950 border border-slate-800 rounded-xl p-2.5 space-y-2 transition-all">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2.5 overflow-hidden">
                  <div class="relative group cursor-pointer flex-shrink-0" onclick="expandCapturedScreen()" title="Haz clic para ver la captura ampliada">
                    <img id="capturedScreenImg" src="" alt="Captura del post" class="w-12 h-16 object-cover rounded-lg border border-slate-700 shadow-md group-hover:brightness-110 transition">
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 bg-black/60 rounded-lg transition">
                      <i data-lucide="zoom-in" class="w-4 h-4 text-white"></i>
                    </div>
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center space-x-1.5">
                      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                      <span id="capturedScreenTitle" class="text-xs font-semibold text-slate-200 truncate">Captura de Pantalla</span>
                    </div>
                    <p id="capturedScreenSubtitle" class="text-[10px] text-slate-400 truncate mt-0.5">Información leída directamente de la imagen</p>
                    <div id="capturedScreenBadges" class="flex flex-wrap gap-1 mt-1"></div>
                  </div>
                </div>
                <div class="flex flex-col items-end space-y-1 pl-2">
                  <button type="button" onclick="captureAndReadScreen()" class="text-[10px] text-sky-400 hover:text-sky-300 flex items-center space-x-1 transition cursor-pointer">
                    <i data-lucide="refresh-cw" class="w-2.5 h-2.5"></i>
                    <span>Recapturar</span>
                  </button>
                  <button type="button" onclick="dismissCapturedScreen()" class="text-[10px] text-slate-500 hover:text-slate-400 transition cursor-pointer">
                    Ocultar
                  </button>
                </div>
              </div>
              <div id="captureErrorHintBanner" class="hidden text-[10px] bg-amber-950/40 border border-amber-800/60 text-amber-300/90 rounded-lg px-2 py-1 leading-tight flex items-center space-x-1.5">
                <i data-lucide="alert-circle" class="w-3.5 h-3.5 text-amber-400 flex-shrink-0"></i>
                <span id="captureErrorHintText"></span>
              </div>
            </div>

            <!-- Textarea Contexto -->
            <div class="space-y-1">
              <textarea id="manualContextPostText" rows="3" 
                        class="w-full bg-slate-950 border border-slate-700/90 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-amber-500 placeholder-slate-600 font-sans leading-relaxed resize-y"
                        placeholder="Escribe, pega aquí el texto o pulsa 'Capturar y Leer Pantalla' para extraerlo automáticamente de la foto del teléfono..."></textarea>
            </div>

            <!-- Concurso / Dinámica Checkbox -->
            <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-2.5 space-y-2">
              <label class="flex items-center justify-between text-xs cursor-pointer select-none">
                <div class="flex items-center space-x-2">
                  <input type="checkbox" id="manualContextIsContest" onchange="toggleManualContextContestFields(this.checked)" 
                         class="rounded bg-slate-800 border-slate-700 text-amber-500 focus:ring-amber-500 w-3.5 h-3.5 cursor-pointer">
                  <span class="text-[11px] font-semibold text-slate-300 flex items-center space-x-1">
                    <span>🏆</span>
                    <span>Esta publicación es dinámica, concurso o pronóstico deportivo</span>
                  </span>
                </div>
                <span class="text-[9px] text-slate-500 font-mono">Reglas de sorteo</span>
              </label>

              <div id="manualContextContestFields" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1 border-t border-slate-800/80 text-xs">
                <div>
                  <label class="text-[10px] text-slate-400 block mb-0.5">Requisito a cumplir / Qué pide:</label>
                  <input type="text" id="manualContextContestReq" 
                         class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-xs text-amber-300 focus:outline-none focus:border-amber-500 placeholder-slate-600" 
                         placeholder="Ej. Comentar pronóstico exacto del Clásico">
                </div>
                <div>
                  <label class="text-[10px] text-slate-400 block mb-0.5">Tema / Equipos / Partido:</label>
                  <input type="text" id="manualContextContestTopic" 
                         class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-xs text-slate-200 focus:outline-none focus:border-amber-500 placeholder-slate-600" 
                         placeholder="Ej. Tigres vs Rayados">
                </div>
              </div>
            </div>

            <!-- BOTÓN DESTACADO: ANALIZAR Y PREVISUALIZAR -->
            <button type="button" onclick="analyzePostAndPreviewComments()" id="btnAnalyzePost" 
                    class="w-full py-2.5 px-3 bg-gradient-to-r from-amber-500 via-orange-500 to-rose-600 hover:from-amber-600 hover:to-rose-700 active:scale-98 text-white font-bold text-xs rounded-xl shadow-lg shadow-orange-500/20 flex items-center justify-center space-x-2 transition cursor-pointer">
              <i data-lucide="sparkles" id="analyzePostIcon" class="w-4 h-4"></i>
              <span id="analyzePostBtnText">🔍 Analizar Publicación y Previsualizar Comentarios</span>
            </button>

            <!-- NOTIFICACIÓN DE ANÁLISIS GENERADO (APUNTA A LA PESTAÑA DERECHA) -->
            <div id="analysisAndPreviewBox" class="hidden p-3 bg-amber-950/30 border border-amber-800/60 rounded-xl space-y-2 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-amber-300 font-bold flex items-center space-x-1.5">
                  <i data-lucide="check-circle" class="w-3.5 h-3.5 text-emerald-400"></i>
                  <span>¡Publicación Analizada!</span>
                </span>
                <span id="analysisTopicBadgeMini" class="px-2 py-0.5 rounded bg-sky-950 text-sky-300 border border-sky-800 text-[10px] font-mono"></span>
              </div>
              <p id="analysisSummaryTextMini" class="text-slate-300 text-[11px] leading-relaxed line-clamp-2"></p>
              <button type="button" onclick="switchTab('comments')" 
                      class="w-full py-1.5 px-2.5 bg-amber-900/60 hover:bg-amber-800 text-amber-200 hover:text-white rounded-lg font-semibold text-[11px] flex items-center justify-center space-x-1.5 transition cursor-pointer border border-amber-700/60 shadow">
                <span>👉 Ver Concepto y Arquetipos en Panel Derecho</span>
                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
              </button>
            </div>

            <!-- Acceso rápido al gestor y selector de modo de comentarios -->
            <div class="flex items-center justify-between px-3 py-2 bg-slate-900/70 border border-slate-800/80 rounded-xl text-xs">
              <span class="text-slate-400 flex items-center space-x-1.5">
                <i data-lucide="message-square" class="w-3.5 h-3.5 text-amber-400"></i>
                <span class="text-[11px]">Modo de Comentarios:</span>
              </span>
              <button type="button" onclick="switchTab('comments')" 
                      class="flex items-center space-x-1 font-bold text-amber-300 hover:text-amber-200 cursor-pointer text-[11px]">
                <span id="currentCommentModeBadge">🤖 Autónomo IA</span>
                <i data-lucide="chevron-right" class="w-3 h-3 text-slate-500"></i>
              </button>
            </div>
          </div>

          <!-- Optional Custom Comment -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="text-[11px] text-slate-400">Comentario personalizado (opcional):</label>
              <span class="text-[10px] text-slate-500">Vacío = Generado por IA</span>
            </div>
            <textarea id="cycleCustomComment" rows="2" 
                      class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-sky-500 placeholder-slate-600 resize-none font-sans"
                      placeholder="Escribe aquí si deseas un comentario específico..."></textarea>
          </div>

          <!-- Repeat Cycle Checkbox -->
          <label class="flex items-center space-x-2 text-xs text-slate-400 cursor-pointer">
            <input type="checkbox" id="cycleRepeat" class="rounded bg-slate-800 border-slate-700 text-amber-500 focus:ring-amber-500">
            <span class="text-[11px]">Repetir ciclo continuamente (bucle infinito hasta detener)</span>
          </label>

          <!-- Cycle Action Buttons -->
          <div class="space-y-2 pt-1">
            <div class="flex space-x-2">
              <button id="btnStartManual" onclick="startManualAutomation()" 
                      class="flex-1 py-2.5 px-3 bg-gradient-to-r from-emerald-500 via-teal-600 to-cyan-600 hover:from-emerald-600 hover:to-cyan-700 active:scale-98 text-white font-bold text-xs rounded-xl shadow-lg shadow-emerald-600/20 flex items-center justify-center space-x-1.5 transition cursor-pointer" title="Inicia directamente abriendo la publicación en el teléfono">
                <i data-lucide="play" class="w-4 h-4 text-white"></i>
                <span>Iniciar Automatización Manual</span>
              </button>
              <button id="btnStopCycle" onclick="stopMultiAccountCycle()" disabled
                      class="py-2.5 px-3 bg-rose-950/60 hover:bg-rose-900 border border-rose-800/80 disabled:opacity-30 disabled:cursor-not-allowed text-rose-300 font-semibold text-xs rounded-xl flex items-center space-x-1.5 transition cursor-pointer">
                <i data-lucide="square" class="w-3.5 h-3.5"></i>
                <span>Detener</span>
              </button>
            </div>

            <!-- Botón del ciclo estándar preservado -->
            <button id="btnStartCycle" onclick="startMultiAccountCycle()" 
                    class="w-full py-1.5 px-2.5 bg-slate-800/60 hover:bg-slate-700 border border-slate-700/60 text-slate-400 hover:text-slate-200 text-[10px] rounded-lg flex items-center justify-center space-x-1.5 transition cursor-pointer" title="Ciclo completo original (con auto-escaneo previo en perfil)">
              <i data-lucide="repeat" class="w-3 h-3 text-amber-400"></i>
              <span>Ciclo Automático Estándar (Con auto-escaneo al inicio)</span>
            </button>
          </div>

          <!-- Multi-Account Cycle Status & Progress Widget -->
          <div id="cycleStatusWidget" class="hidden bg-slate-900/90 border border-slate-800 rounded-xl p-3 space-y-2.5">
            <div class="flex items-center justify-between text-xs">
              <span id="cycleAccountBadge" class="px-2 py-0.5 bg-indigo-950 text-indigo-300 border border-indigo-800 rounded-full font-bold text-[11px]">
                Cuenta 1 de ...
              </span>
              <span id="cycleStepNum" class="text-slate-400 text-[11px] font-mono">Paso 1/16</span>
            </div>
            <div class="text-xs text-slate-300 flex items-start space-x-2">
              <i data-lucide="loader-2" id="cycleSpinner" class="w-3.5 h-3.5 text-amber-400 animate-spin shrink-0 mt-0.5"></i>
              <span id="cycleStepMsg" class="text-[11px] leading-snug">Iniciando...</span>
            </div>
            <div class="w-full bg-slate-950 h-1.5 rounded-full overflow-hidden border border-slate-800">
              <div id="cycleProgressBar" class="bg-gradient-to-r from-amber-500 to-rose-500 h-full transition-all duration-300" style="width: 5%"></div>
            </div>

            <!-- Comment Preview Box -->
            <div id="cycleCommentBox" class="hidden bg-slate-950/90 border border-slate-800 rounded-lg p-2 space-y-1">
              <div class="flex items-center justify-between text-[10px]">
                <span id="cycleCommentArchLabel" class="text-amber-400 font-semibold flex items-center space-x-1">
                  <i data-lucide="sparkles" class="w-3 h-3 text-amber-400"></i>
                  <span>Comentario Único</span>
                </span>
                <span class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-950 text-emerald-400 border border-emerald-800 font-mono">Sin Género · No Yo</span>
              </div>
              <p id="cycleCommentContent" class="text-[11px] text-slate-200 italic leading-snug font-sans"></p>
            </div>
          </div>

          <!-- Error Alert Banner -->
          <div id="cycleErrorAlert" class="hidden bg-rose-950/80 border border-rose-800/80 text-rose-200 text-xs p-3 rounded-xl flex items-start space-x-2">
            <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-400 shrink-0 mt-0.5"></i>
            <div class="flex-1 text-[11px]">
              <span class="font-bold block">Automatización Detenida por Error:</span>
              <span id="cycleErrorMsg">Ha ocurrido un error en el proceso.</span>
            </div>
          </div>
        </div>

        <!-- Sliders: Iterations & Scroll Delay -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1">
            <div class="flex justify-between text-xs text-slate-400">
              <span>Iterations</span>
              <span id="iterVal" class="font-semibold text-sky-400">5</span>
            </div>
            <input type="range" id="iterationsRange" min="1" max="20" value="5" 
                   oninput="document.getElementById('iterVal').innerText = this.value"
                   class="w-full accent-sky-500 bg-slate-800 h-1.5 rounded-lg cursor-pointer">
          </div>
          <div class="space-y-1">
            <div class="flex justify-between text-xs text-slate-400">
              <span>Scroll Wait</span>
              <span id="delayVal" class="font-semibold text-indigo-400">2.5s</span>
            </div>
            <input type="range" id="delayRange" min="1.0" max="8.0" step="0.5" value="2.5" 
                   oninput="document.getElementById('delayVal').innerText = this.value + 's'"
                   class="w-full accent-indigo-500 bg-slate-800 h-1.5 rounded-lg cursor-pointer">
          </div>
        </div>

        <!-- RUN / STOP BUTTONS -->
        <div class="flex space-x-3 pt-2">
          <button id="startBtn" onclick="startAutomation()" class="flex-1 py-3 px-4 bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-600 hover:to-indigo-700 active:scale-98 text-white text-sm font-semibold rounded-xl shadow-lg shadow-sky-500/25 flex items-center justify-center space-x-2 transition">
            <i data-lucide="play" class="w-4 h-4"></i>
            <span>Start Automation</span>
          </button>
          <button id="stopBtn" onclick="stopAutomation()" disabled class="py-3 px-5 bg-rose-950/60 hover:bg-rose-900 border border-rose-800/80 disabled:opacity-40 disabled:cursor-not-allowed text-rose-300 text-sm font-semibold rounded-xl flex items-center justify-center space-x-2 transition">
            <i data-lucide="square" class="w-4 h-4"></i>
            <span>Stop</span>
          </button>
        </div>
      </div>

      <!-- LOCAL AI MODELS CARD (OLLAMA) -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl flex flex-col space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="p-1.5 bg-gradient-to-tr from-purple-500 to-indigo-600 rounded-lg shadow-md shadow-purple-500/20">
              <i data-lucide="cpu" class="w-4 h-4 text-white"></i>
            </div>
            <div>
              <h2 class="font-semibold text-slate-200 text-sm">Modelos de IA Locales (Ollama)</h2>
              <p class="text-[11px] text-slate-400">Detecta y selecciona las IAs de tu PC</p>
            </div>
          </div>
          <!-- User-requested button to list/scan models -->
          <button id="btnScanModels" onclick="scanLocalModels(true)" 
                  class="px-3 py-1.5 bg-purple-600 hover:bg-purple-500 active:scale-95 text-white text-xs font-semibold rounded-xl flex items-center space-x-1.5 shadow-md shadow-purple-600/20 transition cursor-pointer" title="Listar y escanear IAs locales">
            <i data-lucide="refresh-cw" id="scanModelsIcon" class="w-3.5 h-3.5"></i>
            <span>Detectar IAs Locales</span>
          </button>
        </div>

        <!-- ACTIVE MODELS STATUS -->
        <div class="bg-slate-950/80 border border-slate-800/80 rounded-xl p-3 flex flex-col space-y-2 text-xs">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">IAs actualmente activas:</span>
            <span id="modelScanCount" class="text-[10px] text-purple-400 font-medium">Detectando...</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div class="flex items-center space-x-2 bg-slate-900/90 border border-purple-900/50 px-2.5 py-1.5 rounded-lg">
              <span class="text-[11px] text-purple-400 font-semibold flex items-center space-x-1 shrink-0">
                <i data-lucide="eye" class="w-3 h-3"></i>
                <span>Visión:</span>
              </span>
              <span id="lblActiveVision" class="font-mono text-slate-200 text-[11px] truncate">qwen2.5vl:latest</span>
            </div>
            <div class="flex items-center space-x-2 bg-slate-900/90 border border-sky-900/50 px-2.5 py-1.5 rounded-lg">
              <span class="text-[11px] text-sky-400 font-semibold flex items-center space-x-1 shrink-0">
                <i data-lucide="message-square" class="w-3 h-3"></i>
                <span>Texto:</span>
              </span>
              <span id="lblActiveText" class="font-mono text-slate-200 text-[11px] truncate">qwen3:latest</span>
            </div>
          </div>
        </div>

        <!-- DROPDOWN SELECTION -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
          <div class="space-y-1">
            <label class="text-[11px] font-medium text-slate-400 flex items-center space-x-1">
              <i data-lucide="eye" class="w-3 h-3 text-purple-400"></i>
              <span>IA para Visión (Leer pantalla/post)</span>
            </label>
            <select id="selectVisionModel" onchange="onModelDropdownChange()"
                    class="w-full bg-slate-950 border border-slate-800 rounded-xl px-2.5 py-2 text-xs text-slate-200 focus:outline-none focus:border-purple-500 font-mono">
              <option value="">Cargando modelos...</option>
            </select>
          </div>
          <div class="space-y-1">
            <label class="text-[11px] font-medium text-slate-400 flex items-center space-x-1">
              <i data-lucide="message-circle" class="w-3 h-3 text-sky-400"></i>
              <span>IA para Texto (Generar comentarios)</span>
            </label>
            <select id="selectTextModel" onchange="onModelDropdownChange()"
                    class="w-full bg-slate-950 border border-slate-800 rounded-xl px-2.5 py-2 text-xs text-slate-200 focus:outline-none focus:border-sky-500 font-mono">
              <option value="">Cargando modelos...</option>
            </select>
          </div>
        </div>

        <!-- LIST OF DETECTED LOCAL MODELS -->
        <div class="space-y-1.5 pt-1 border-t border-slate-800/80">
          <div class="flex items-center justify-between text-xs text-slate-400">
            <span class="font-medium text-[11px]">Modelos disponibles en tu computadora:</span>
            <span id="modelScanTimestamp" class="text-[10px] text-slate-500">Auto-cargado</span>
          </div>
          <div id="localModelsList" class="space-y-2 max-h-52 overflow-y-auto pr-1">
            <!-- Dynamic model cards -->
            <div class="text-xs text-slate-500 italic p-3 text-center border border-slate-800/60 rounded-xl bg-slate-950/40">
              Haz clic en "Detectar IAs Locales" para listar las IAs instaladas en Ollama.
            </div>
          </div>
        </div>

        <!-- APPLY BUTTON -->
        <button id="btnApplyModels" onclick="applyModelSelection()" 
                class="w-full py-2.5 px-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 active:scale-98 text-white text-xs font-semibold rounded-xl shadow-md shadow-purple-600/20 flex items-center justify-center space-x-2 transition cursor-pointer">
          <i data-lucide="check" class="w-3.5 h-3.5"></i>
          <span>Aplicar Selección de IA para el Automator</span>
        </button>
      </div>
    </div>

    <!-- RIGHT COLUMN: FEED ANALYSIS, TERMINAL & RESULTS (7 COLS) -->
    <div class="lg:col-span-7 flex flex-col space-y-6">

      <!-- TAB NAVIGATION -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-1.5 flex space-x-1 shadow-lg">
        <button id="tabFeedBtn" onclick="switchTab('feed')" class="flex-1 py-2 px-2 rounded-xl text-xs font-semibold flex items-center justify-center space-x-1 transition bg-sky-600 text-white shadow">
          <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
          <span>Live Feed</span>
        </button>
        <button id="tabCommentsBtn" onclick="switchTab('comments')" class="flex-1 py-2 px-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-amber-300 flex items-center justify-center space-x-1 transition">
          <i data-lucide="message-square" class="w-3.5 h-3.5 text-amber-400"></i>
          <span>Comentarios & Análisis</span>
        </button>
        <button id="tabFacebookBtn" onclick="switchTab('facebook')" class="flex-1 py-2 px-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-blue-400 flex items-center justify-center space-x-1 transition">
          <i data-lucide="facebook" class="w-3.5 h-3.5 text-blue-500"></i>
          <span class="font-bold text-blue-300">Facebook</span>
        </button>
        <button id="tabSimBtn" onclick="switchTab('sim')" class="flex-1 py-2 px-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-amber-300 flex items-center justify-center space-x-1 transition">
          <i data-lucide="bot" class="w-3.5 h-3.5 text-amber-400"></i>
          <span>Simulador IA</span>
        </button>
        <button id="tabIconsBtn" onclick="switchTab('icons')" class="flex-1 py-2 px-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1 transition">
          <i data-lucide="crosshair" class="w-3.5 h-3.5 text-rose-400"></i>
          <span>Gestor Iconos</span>
        </button>
        <button id="tabTerminalBtn" onclick="switchTab('terminal')" class="flex-1 py-2 px-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1 transition">
          <i data-lucide="terminal" class="w-3.5 h-3.5"></i>
          <span>Terminal</span>
        </button>
        <button id="tabHistoryBtn" onclick="switchTab('history')" class="flex-1 py-2 px-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-slate-200 flex items-center justify-center space-x-1 transition">
          <i data-lucide="database" class="w-3.5 h-3.5"></i>
          <span>Resultados</span>
        </button>
      </div>

      <!-- TAB 1: LIVE ANALYSIS FEED -->
      <div id="tabFeedContent" class="flex-1 flex flex-col space-y-4 min-h-[500px]">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-semibold text-slate-300 flex items-center space-x-2">
            <span>Identified Posts & AI Analysis</span>
            <span id="postsCountBadge" class="px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 text-xs">0 posts</span>
          </h3>
          <button onclick="clearFeedCards()" class="text-xs text-slate-500 hover:text-slate-400 transition">Clear Stream</button>
        </div>

        <div id="feedCardsContainer" class="flex-1 space-y-4 overflow-y-auto max-h-[640px] pr-2">
          <!-- Empty State -->
          <div id="feedEmptyState" class="h-64 border-2 border-dashed border-slate-800 rounded-2xl flex flex-col items-center justify-center text-slate-500">
            <i data-lucide="scan-eye" class="w-10 h-10 mb-2 text-slate-600"></i>
            <p class="text-sm font-medium">No posts extracted yet</p>
            <p class="text-xs text-slate-600 mt-1">Start automation to analyze feed posts with Qwen2-VL & Llama3</p>
          </div>
        </div>
      </div>

      <!-- TAB 2: COMENTARIOS Y ANÁLISIS DEL POST (COLUMNA DERECHA) -->
      <div id="tabCommentsContent" class="hidden flex-1 flex flex-col space-y-4 min-h-[500px]">
        
        <!-- Header del Tab -->
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="p-1.5 bg-gradient-to-tr from-amber-500 to-rose-600 rounded-lg shadow-md shadow-amber-500/20">
              <i data-lucide="message-square" class="w-4 h-4 text-white"></i>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-slate-200">Comentarios & Análisis de la Publicación</h3>
              <p class="text-[11px] text-slate-400">Configura el modo de comentarios, gestiona tu lista y visualiza el análisis de IA</p>
            </div>
          </div>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-950 text-amber-300 border border-amber-800 font-mono">
            2 Opciones de Automatización
          </span>
        </div>

        <!-- SELECTOR DE 2 MODOS DE AUTOMATIZACIÓN DE COMENTARIOS -->
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 space-y-2.5">
          <div class="flex items-center justify-between">
            <label class="text-xs font-semibold text-slate-200 flex items-center space-x-1.5">
              <i data-lucide="sliders" class="w-3.5 h-3.5 text-amber-400"></i>
              <span>Modo de Automatización de Comentarios:</span>
            </label>
            <span class="text-[10px] text-slate-400 font-mono">Elige cómo comentará cada cuenta</span>
          </div>

          <input type="hidden" id="selectedCommentMode" value="auto">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <!-- Opción 1: Modo Autónomo (IA & Memoria) -->
            <div id="commentModeAutoCard" onclick="selectCommentMode('auto')"
                 class="cursor-pointer rounded-xl border-2 border-amber-500 bg-amber-950/25 p-3 space-y-1.5 transition-all shadow-md shadow-amber-950/20">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <div class="w-4 h-4 rounded-full border-2 border-amber-400 flex items-center justify-center bg-amber-500">
                    <div id="radioDotAuto" class="w-1.5 h-1.5 rounded-full bg-slate-950"></div>
                  </div>
                  <span class="text-xs font-bold text-amber-300">🤖 Opción 1: Modo Autónomo IA</span>
                </div>
                <span class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono">Recomendado</span>
              </div>
              <p class="text-[11px] text-slate-300 leading-relaxed font-sans">
                La IA analiza el post en vivo y genera comentarios únicos con memoria en <code class="text-amber-300">agents.md</code> (0 emojis, máx 3 líneas, rotación).
                <span class="text-amber-200/90 font-medium block mt-1">💡 Si pegas comentarios abajo, los toma como apoyo de contexto e inspiración temática.</span>
              </p>
            </div>

            <!-- Opción 2: Lista Predefinida (Comentarios Pegados) -->
            <div id="commentModePresetCard" onclick="selectCommentMode('preset_list')"
                 class="cursor-pointer rounded-xl border-2 border-slate-800 bg-slate-900/60 hover:border-slate-700 p-3 space-y-1.5 transition-all">
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <div class="w-4 h-4 rounded-full border-2 border-slate-600 flex items-center justify-center bg-transparent">
                    <div id="radioDotPreset" class="w-1.5 h-1.5 rounded-full bg-transparent"></div>
                  </div>
                  <span class="text-xs font-bold text-slate-300">📝 Opción 2: Lista Predefinida</span>
                </div>
                <span class="text-[9px] px-1.5 py-0.2 rounded bg-slate-800 text-slate-400 border border-slate-700 font-mono">Secuencial</span>
              </div>
              <p class="text-[11px] text-slate-400 leading-relaxed font-sans">
                La automatización rota de forma secuencial por la lista de comentarios pegados abajo (1 comentario por cuenta/vuelta) y los registra en la memoria.
                <span class="text-sky-300/90 font-medium block mt-1">📌 Ideal si ya tienes redactados 10+ comentarios específicos y quieres usarlos directos.</span>
              </p>
            </div>
          </div>
        </div>

        <!-- ÁREA PARA PEGAR 10 O MÁS COMENTARIOS -->
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 space-y-2">
          <div class="flex items-center justify-between">
            <label class="text-xs font-semibold text-slate-200 flex items-center space-x-1.5">
              <i data-lucide="clipboard-list" class="w-3.5 h-3.5 text-sky-400"></i>
              <span>Banco de Comentarios Personalizados (Pega 10 o más):</span>
            </label>
            <div class="flex items-center space-x-2">
              <span id="pastedCommentsBadge" class="text-[10px] px-2 py-0.5 rounded-full font-mono bg-slate-800 text-slate-400 border border-slate-700">
                0 comentarios
              </span>
            </div>
          </div>

          <textarea id="pastedCommentsTextarea" rows="6" oninput="updatePastedCommentsCount()"
                    class="w-full bg-slate-900 border border-slate-700/80 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-amber-500 placeholder-slate-500 resize-none font-sans leading-relaxed"
                    placeholder="Pega aquí 10 comentarios o más (un comentario por línea)...&#10;Ejemplo:&#10;Qué buena toma lograron en ese momento&#10;Con todo el enfoque para el fin de semana&#10;Esa concentración se nota a la distancia&#10;Gran ambiente que se siente en la foto&#10;Directo al objetivo con ese ritmo&#10;..."></textarea>

          <!-- Barra de herramientas auxiliar -->
          <div class="flex items-center justify-between pt-1 flex-wrap gap-2 text-xs">
            <div class="flex items-center space-x-1.5">
              <button type="button" onclick="shufflePastedComments()" 
                      class="px-2.5 py-1 bg-slate-850 hover:bg-slate-800 active:scale-95 text-slate-300 hover:text-white border border-slate-700/80 rounded-lg text-[11px] font-medium transition flex items-center space-x-1 cursor-pointer">
                <i data-lucide="shuffle" class="w-3 h-3 text-sky-400"></i>
                <span>Barajar lista</span>
              </button>
              <button type="button" onclick="appendSuggestionsToPastedList()" 
                      class="px-2.5 py-1 bg-amber-950/60 hover:bg-amber-900/80 active:scale-95 text-amber-200 hover:text-white border border-amber-800/80 rounded-lg text-[11px] font-medium transition flex items-center space-x-1 cursor-pointer" title="Carga los 5 arquetipos y las 4 narrativas generadas por la IA a la lista">
                <i data-lucide="plus-circle" class="w-3 h-3 text-amber-400"></i>
                <span>Cargar sugerencias IA a la lista</span>
              </button>
            </div>
            <button type="button" onclick="clearPastedComments()" 
                    class="px-2 py-1 text-[11px] text-slate-500 hover:text-rose-400 transition cursor-pointer flex items-center space-x-1">
              <i data-lucide="trash-2" class="w-3 h-3"></i>
              <span>Limpiar</span>
            </button>
          </div>
        </div>

        <!-- CONTENEDOR DE ANÁLISIS DE CONCEPTO Y DINÁMICAS (Llenado dinámicamente) -->
        <div id="rightAnalysisContainer" class="hidden space-y-3">
          <!-- Tarjeta 1: ¿De qué trata la publicación? -->
          <div class="bg-slate-950/90 border border-slate-800 rounded-xl p-3 space-y-2 shadow">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-amber-400 flex items-center space-x-1.5">
                <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i>
                <span>¿De qué trata la publicación? (Concepto & Dinámica)</span>
              </span>
              <div id="rightAnalysisBadges" class="flex flex-wrap gap-1"></div>
            </div>
            <p id="rightAnalysisSummary" class="text-xs text-slate-200 leading-relaxed font-sans bg-slate-900/80 p-2.5 rounded-lg border border-slate-800/80"></p>
            <div id="rightAnalysisDetailsGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-slate-400 pt-1"></div>
          </div>

          <!-- Tarjeta 2: 5 Arquetipos Humanos con Memoria Persistente (agents.md) -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-amber-300 flex items-center space-x-1.5">
                <i data-lucide="brain" class="w-3.5 h-3.5 text-amber-400"></i>
                <span>5 Arquetipos Humanos (Memoria agents.md):</span>
              </span>
              <div class="flex items-center space-x-1.5">
                <span class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-950 text-emerald-300 border border-emerald-800 font-mono">0 Emojis · Máx 3 Líneas</span>
                <button type="button" onclick="showMemoryModal()" class="text-[10px] text-amber-400 hover:text-amber-300 underline cursor-pointer" title="Ver historial de memoria en agents.md">
                  Ver Memoria
                </button>
              </div>
            </div>
            <div id="rightHumanSamplesList" class="grid grid-cols-1 gap-2 max-h-[320px] overflow-y-auto pr-1"></div>
          </div>

          <!-- Tarjeta 3: Ejemplos según cada Postura / Narrativa -->
          <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-3 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-200 flex items-center space-x-1.5">
                <i data-lucide="message-square" class="w-3.5 h-3.5 text-sky-400"></i>
                <span>Ejemplos por Tipo de Postura:</span>
              </span>
              <span class="text-[10px] text-slate-400">Haz clic en "[➕ Añadir a lista]" o "[Usar como único]"</span>
            </div>
            <div id="rightNarrativeSamplesList" class="grid grid-cols-1 gap-2"></div>
          </div>

          <!-- Tarjeta 4: Simulación para las Cuentas del Ciclo -->
          <div id="rightAccountSamplesContainer" class="hidden bg-slate-950/80 border border-slate-800 rounded-xl p-3 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-indigo-300 flex items-center space-x-1.5">
                <i data-lucide="users" class="w-3.5 h-3.5 text-indigo-400"></i>
                <span>Simulación para las Cuentas del Ciclo:</span>
              </span>
              <span id="rightAccountSamplesCountBadge" class="text-[10px] px-1.5 py-0.2 rounded bg-indigo-950 text-indigo-300 border border-indigo-800 font-mono"></span>
            </div>
            <div id="rightAccountSamplesList" class="grid grid-cols-1 gap-2 max-h-[260px] overflow-y-auto pr-1"></div>
          </div>
        </div>

        <!-- Estado vacío cuando no se ha analizado aún -->
        <div id="rightCommentsEmptyState" class="h-64 border-2 border-dashed border-slate-800 rounded-2xl flex flex-col items-center justify-center text-slate-500 p-6 text-center">
          <i data-lucide="sparkles" class="w-10 h-10 mb-2 text-amber-500/60"></i>
          <p class="text-sm font-semibold text-slate-300">Aún no has analizado una publicación</p>
          <p class="text-xs text-slate-500 mt-1 max-w-sm">
            Escribe o captura el post en el panel izquierdo y pulsa <strong class="text-amber-400">"🔍 Analizar Publicación y Previsualizar Comentarios"</strong>. Aquí aparecerá el concepto y los ejemplos generados.
          </p>
        </div>

      </div>

      <!-- TAB: FACEBOOK AUTOMATOR (EN CONSTRUCCIÓN PASO A PASO) -->
      <div id="tabFacebookContent" class="hidden flex-1 flex flex-col space-y-4 min-h-[500px]">
        
        <!-- HEADER BANNER FACEBOOK -->
        <div class="bg-gradient-to-r from-blue-950/70 via-blue-900/30 to-slate-900 border border-blue-800/50 rounded-2xl p-4 shadow-xl flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="p-2.5 bg-blue-600 text-white rounded-xl shadow-lg shadow-blue-600/30">
              <i data-lucide="facebook" class="w-6 h-6"></i>
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <h3 class="text-base font-bold text-white">Módulo de Automatización para Facebook</h3>
                <span class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30">En Construcción</span>
              </div>
              <p class="text-xs text-blue-200/80 mt-0.5">
                Diseñando el proceso paso a paso: apertura de publicación, reacciones, comentarios y publicación.
              </p>
            </div>
          </div>
          <div class="hidden sm:flex items-center space-x-2 text-xs">
            <span class="px-2.5 py-1 rounded-lg bg-slate-800/80 border border-slate-700 text-slate-300 font-mono text-[11px]">
              fb:// & com.facebook
            </span>
          </div>
        </div>

        <!-- CONFIGURACIÓN DE FACEBOOK (APP & TIPO DE CONTENIDO) -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-lg space-y-4">
          <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center space-x-2">
            <i data-lucide="settings-2" class="w-4 h-4 text-blue-400"></i>
            <span>1. Configuración de la App & Tipo de Publicación</span>
          </h4>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Selector de Paquete Facebook -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1.5">App de Facebook en el Teléfono:</label>
              <div class="grid grid-cols-2 gap-2">
                <label class="flex items-center space-x-2 p-2.5 rounded-xl border border-blue-500/40 bg-blue-950/20 cursor-pointer hover:border-blue-400 transition">
                  <input type="radio" name="fbPackageChoice" value="com.facebook.katana" checked class="text-blue-600 focus:ring-blue-500">
                  <div class="text-xs">
                    <span class="font-bold text-slate-200 block">Facebook Estándar</span>
                    <span class="text-[10px] text-slate-400">com.facebook.katana</span>
                  </div>
                </label>
                <label class="flex items-center space-x-2 p-2.5 rounded-xl border border-slate-700 bg-slate-800/40 cursor-pointer hover:border-blue-400 transition">
                  <input type="radio" name="fbPackageChoice" value="com.facebook.lite" class="text-blue-600 focus:ring-blue-500">
                  <div class="text-xs">
                    <span class="font-bold text-slate-200 block">Facebook Lite</span>
                    <span class="text-[10px] text-slate-400">com.facebook.lite</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Selector de Tipo de Contenido -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1.5">Tipo de Contenido a Automatizar:</label>
              <div class="grid grid-cols-3 gap-2 text-xs">
                <label class="flex items-center justify-center p-2 rounded-xl border border-blue-500/40 bg-blue-950/20 cursor-pointer hover:border-blue-400 transition">
                  <input type="radio" name="fbMediaType" value="post" checked class="hidden">
                  <span class="font-semibold text-slate-200 flex items-center space-x-1">
                    <i data-lucide="file-text" class="w-3.5 h-3.5 text-blue-400"></i>
                    <span>Post Feed</span>
                  </span>
                </label>
                <label class="flex items-center justify-center p-2 rounded-xl border border-slate-700 bg-slate-800/40 cursor-pointer hover:border-blue-400 transition">
                  <input type="radio" name="fbMediaType" value="reel" class="hidden">
                  <span class="font-semibold text-slate-300 flex items-center space-x-1">
                    <i data-lucide="clapperboard" class="w-3.5 h-3.5 text-rose-400"></i>
                    <span>FB Reel</span>
                  </span>
                </label>
                <label class="flex items-center justify-center p-2 rounded-xl border border-slate-700 bg-slate-800/40 cursor-pointer hover:border-blue-400 transition">
                  <input type="radio" name="fbMediaType" value="group" class="hidden">
                  <span class="font-semibold text-slate-300 flex items-center space-x-1">
                    <i data-lucide="users" class="w-3.5 h-3.5 text-emerald-400"></i>
                    <span>Grupo FB</span>
                  </span>
                </label>
              </div>
            </div>
          </div>

          <!-- ENTRADA DE ENLACE DE FACEBOOK -->
          <div class="space-y-2 pt-2 border-t border-slate-800">
            <label class="block text-xs font-semibold text-slate-300">Enlace de la Publicación o Reel de Facebook:</label>
            <div class="flex space-x-2">
              <input type="text" id="fbUrlInput" placeholder="https://www.facebook.com/... o https://fb.watch/..." 
                     class="flex-1 bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
              <button onclick="testOpenFacebookPost()" 
                      class="px-4 py-2 bg-blue-600 hover:bg-blue-500 active:scale-95 text-white text-xs font-semibold rounded-xl shadow-md shadow-blue-600/30 flex items-center space-x-1.5 transition cursor-pointer">
                <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                <span>Abrir en Teléfono</span>
              </button>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-400 pt-1">
              <label class="flex items-center space-x-2 cursor-pointer">
                <input type="checkbox" id="fbUseCurrentScreen" class="rounded bg-slate-800 border-slate-700 text-blue-500 focus:ring-blue-500">
                <span>Usar la pantalla que ya tengo abierta en Facebook (omitir navegación)</span>
              </label>
              <button onclick="takeManualCapture()" class="text-blue-400 hover:text-blue-300 transition flex items-center space-x-1">
                <i data-lucide="camera" class="w-3 h-3"></i>
                <span>Actualizar Pantalla</span>
              </button>
            </div>

            <!-- CONTROL DE DESLIZAMIENTO SUAVE Y TIEMPO DE ESPERA PARA ESCANEAR -->
            <div class="mt-2.5 p-3 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
              <div class="flex items-center justify-between">
                <label class="flex items-center space-x-2 cursor-pointer">
                  <input type="checkbox" id="fbAutoScroll" class="rounded bg-slate-800 border-slate-700 text-blue-500 focus:ring-blue-500" checked>
                  <span class="text-xs font-semibold text-slate-200">Deslizar hacia abajo tras abrir para revelar los iconos</span>
                </label>
                <span class="text-[10px] text-blue-400 bg-blue-950/60 border border-blue-800/60 px-2 py-0.5 rounded-full font-mono">
                  Me gusta / Comentar
                </span>
              </div>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1 border-t border-slate-800/60 text-xs">
                <div class="flex items-center space-x-2">
                  <span class="text-slate-400 text-[11px] whitespace-nowrap">Deslizamiento:</span>
                  <select id="fbScrollPixels" class="bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-slate-200 text-xs focus:outline-none focus:border-blue-500">
                    <option value="200">200 px (Corto)</option>
                    <option value="280" selected>280 px (Recomendado)</option>
                    <option value="350">350 px (Largo)</option>
                  </select>
                </div>
                <div class="flex items-center space-x-2">
                  <span class="text-slate-400 text-[11px] whitespace-nowrap">Pausa antes de escanear:</span>
                  <select id="fbWaitAfterScroll" class="bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-slate-200 text-xs focus:outline-none focus:border-blue-500">
                    <option value="1.5">1.5 s (Rápido)</option>
                    <option value="2.5" selected>2.5 s (Recomendado)</option>
                    <option value="3.5">3.5 s (Conexión lenta)</option>
                  </select>
                </div>
              </div>

              <div class="flex items-center justify-between pt-1 border-t border-slate-800/60 text-[11px]">
                <label class="flex items-center space-x-2 cursor-pointer text-slate-300">
                  <input type="checkbox" id="fbAutoScan" class="rounded bg-slate-800 border-slate-700 text-blue-500 focus:ring-blue-500" checked>
                  <span>Escanear y ubicar botones automáticamente tras la pausa</span>
                </label>
                <button type="button" onclick="fbManualGentleScroll()" class="text-sky-400 hover:text-sky-300 flex items-center space-x-1 font-medium transition cursor-pointer">
                  <i data-lucide="chevrons-down" class="w-3.5 h-3.5"></i>
                  <span>Solo deslizar ahora</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- ESCÁNER DIAGNÓSTICO DE LA UI DE FACEBOOK -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-lg space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center space-x-2">
              <i data-lucide="scan" class="w-4 h-4 text-sky-400"></i>
              <span>2. Diagnóstico de Botones en Pantalla de Facebook</span>
            </h4>
            <button id="btnScanFacebookUI" onclick="scanFacebookUI()" 
                    class="py-1.5 px-3 bg-slate-800 hover:bg-slate-700 active:scale-95 text-sky-300 border border-sky-500/30 text-xs font-semibold rounded-xl flex items-center space-x-1.5 transition cursor-pointer shadow-sm">
              <i data-lucide="crosshair" class="w-3.5 h-3.5"></i>
              <span>Escanear Botones Actuales</span>
            </button>
          </div>
          <p class="text-[11px] text-slate-400">
            Abre la publicación en tu teléfono y pulsa "Escanear". El sistema analizará la jerarquía visual de Facebook para detectar los botones y calibrar los toques con exactitud.
          </p>

          <!-- TARJETAS DE BOTONES DETECTADOS -->
          <div id="fbScanResultsGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1">
            <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex flex-col items-center justify-center text-center">
              <i data-lucide="thumbs-up" class="w-5 h-5 text-slate-500 mb-1" id="fbIconLike"></i>
              <span class="text-xs font-bold text-slate-300">Botón Like</span>
              <span id="fbCoordLike" class="text-[10px] text-slate-500 font-mono mt-0.5">Sin escanear</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex flex-col items-center justify-center text-center">
              <i data-lucide="message-circle" class="w-5 h-5 text-slate-500 mb-1" id="fbIconComment"></i>
              <span class="text-xs font-bold text-slate-300">Botón Comentar</span>
              <span id="fbCoordComment" class="text-[10px] text-slate-500 font-mono mt-0.5">Sin escanear</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex flex-col items-center justify-center text-center">
              <i data-lucide="edit-3" class="w-5 h-5 text-slate-500 mb-1" id="fbIconInput"></i>
              <span class="text-xs font-bold text-slate-300">Caja de Texto</span>
              <span id="fbCoordInput" class="text-[10px] text-slate-500 font-mono mt-0.5">Sin escanear</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 flex flex-col items-center justify-center text-center">
              <i data-lucide="send" class="w-5 h-5 text-slate-500 mb-1" id="fbIconSend"></i>
              <span class="text-xs font-bold text-slate-300">Botón Publicar</span>
              <span id="fbCoordSend" class="text-[10px] text-slate-500 font-mono mt-0.5">Sin escanear</span>
            </div>
          </div>
          <div id="fbScanLog" class="text-[11px] text-slate-400 italic hidden"></div>
        </div>

        <!-- HOJA DE RUTA: FORMANDO EL PROCESO DE FACEBOOK -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-lg space-y-3">
          <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center space-x-2">
            <i data-lucide="list-ordered" class="w-4 h-4 text-emerald-400"></i>
            <span>3. Proceso de Automatización para Facebook (Paso a Paso)</span>
          </h4>
          <p class="text-[11px] text-slate-400">
            A continuación se detallan los pasos del flujo que iremos probando y calibrando juntos:
          </p>

          <div class="space-y-2 text-xs">
            <!-- Paso 1 -->
            <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800/80 flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="w-6 h-6 rounded-full bg-blue-900/60 text-blue-300 font-bold flex items-center justify-center text-[11px] border border-blue-700/50">1</span>
                <div>
                  <span class="font-semibold text-slate-200 block">Apertura de la Publicación / Reel</span>
                  <span class="text-[10px] text-slate-400">Lanza la URL en Facebook y espera 3.5s a que cargue el contenido.</span>
                </div>
              </div>
              <span class="px-2 py-0.5 text-[10px] rounded bg-emerald-950 text-emerald-300 border border-emerald-800 font-medium">Listo</span>
            </div>

            <!-- Paso 2 -->
            <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800/80 flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="w-6 h-6 rounded-full bg-blue-900/60 text-blue-300 font-bold flex items-center justify-center text-[11px] border border-blue-700/50">2</span>
                <div>
                  <span class="font-semibold text-slate-200 block">Captura de Pantalla & Análisis con IA</span>
                  <span class="text-[10px] text-slate-400">Lee el contenido de la publicación con Visión (Qwen2.5-VL / Llama3) para entender el tema.</span>
                </div>
              </div>
              <span class="px-2 py-0.5 text-[10px] rounded bg-emerald-950 text-emerald-300 border border-emerald-800 font-medium">Listo</span>
            </div>

            <!-- Paso 3 -->
            <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800/80 flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="w-6 h-6 rounded-full bg-amber-900/60 text-amber-300 font-bold flex items-center justify-center text-[11px] border border-amber-700/50">3</span>
                <div>
                  <span class="font-semibold text-slate-200 block">Tocar Botón "Me gusta" (👍 o Reacción)</span>
                  <span class="text-[10px] text-slate-400">Localizar el botón de Like de Facebook y dar toque natural.</span>
                </div>
              </div>
              <span class="px-2 py-0.5 text-[10px] rounded bg-amber-950 text-amber-300 border border-amber-800 font-medium">Siguiente Paso</span>
            </div>

            <!-- Paso 4 -->
            <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800/80 flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="w-6 h-6 rounded-full bg-slate-800 text-slate-400 font-bold flex items-center justify-center text-[11px] border border-slate-700">4</span>
                <div>
                  <span class="font-semibold text-slate-200 block">Abrir Sección de Comentarios</span>
                  <span class="text-[10px] text-slate-400">Pulsar botón "Comentar" para desplegar la lista y la caja de texto.</span>
                </div>
              </div>
              <span class="px-2 py-0.5 text-[10px] rounded bg-slate-800 text-slate-400 font-medium">Pendiente</span>
            </div>

            <!-- Paso 5 -->
            <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800/80 flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="w-6 h-6 rounded-full bg-slate-800 text-slate-400 font-bold flex items-center justify-center text-[11px] border border-slate-700">5</span>
                <div>
                  <span class="font-semibold text-slate-200 block">Escribir Comentario Naturalmente</span>
                  <span class="text-[10px] text-slate-400">Enfocar caja ("Escribe un comentario...") y escribir palabra por palabra (Modo IA o Lista pegada).</span>
                </div>
              </div>
              <span class="px-2 py-0.5 text-[10px] rounded bg-slate-800 text-slate-400 font-medium">Pendiente</span>
            </div>

            <!-- Paso 6 -->
            <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800/80 flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="w-6 h-6 rounded-full bg-slate-800 text-slate-400 font-bold flex items-center justify-center text-[11px] border border-slate-700">6</span>
                <div>
                  <span class="font-semibold text-slate-200 block">Pulsar Botón de Envío (Publicar)</span>
                  <span class="text-[10px] text-slate-400">Tocar el botón azul de envío/flecha y cerrar comentarios.</span>
                </div>
              </div>
              <span class="px-2 py-0.5 text-[10px] rounded bg-slate-800 text-slate-400 font-medium">Pendiente</span>
            </div>
          </div>
        </div>

        <!-- SECCIÓN 4: EJECUTOR DEL PROCESO COMPLETO DE FACEBOOK -->
        <div class="bg-gradient-to-br from-blue-950/40 via-slate-900 to-slate-900 border border-blue-800/40 rounded-2xl p-4 shadow-xl space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider flex items-center space-x-2">
              <i data-lucide="play-circle" class="w-4 h-4 text-blue-400"></i>
              <span>4. Ejecutar Flujo de Interacción en Facebook</span>
            </h4>
            <span class="text-[10px] text-blue-300 font-mono bg-blue-900/50 border border-blue-700/50 px-2 py-0.5 rounded-full">
              Like 👍 + Comentario 💬
            </span>
          </div>

          <!-- Opciones Rápidas de Interacción -->
          <div class="grid grid-cols-2 gap-3 pt-1 text-xs">
            <label class="flex items-center space-x-2 p-2.5 rounded-xl border border-slate-800 bg-slate-950/60 cursor-pointer hover:border-blue-500/40 transition">
              <input type="checkbox" id="fbDoLike" class="rounded bg-slate-800 border-slate-700 text-blue-500 focus:ring-blue-500" checked>
              <div>
                <span class="font-bold text-slate-200 block">Dar Touch en Like (👍)</span>
                <span class="text-[10px] text-slate-400">Primer botón a la izquierda</span>
              </div>
            </label>
            <label class="flex items-center space-x-2 p-2.5 rounded-xl border border-slate-800 bg-slate-950/60 cursor-pointer hover:border-blue-500/40 transition">
              <input type="checkbox" id="fbDoComment" class="rounded bg-slate-800 border-slate-700 text-blue-500 focus:ring-blue-500" checked>
              <div>
                <span class="font-bold text-slate-200 block">Comentar Publicación (💬)</span>
                <span class="text-[10px] text-slate-400">Abre comentarios y publica</span>
              </div>
            </label>
          </div>

          <!-- Resumen de Contexto Activo -->
          <div class="p-2.5 rounded-xl bg-slate-950/80 border border-slate-800 flex items-center justify-between text-xs">
            <div class="flex items-center space-x-2">
              <i data-lucide="brain-circuit" class="w-4 h-4 text-amber-400"></i>
              <div>
                <span class="text-slate-300 font-semibold block">Contexto de la Publicación:</span>
                <span class="text-[10px] text-slate-400">Si escribes en "Contexto de la Publicación" a la izquierda se usa ese texto; si está vacío, la IA lo lee en vivo de la pantalla.</span>
              </div>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded bg-blue-950 text-blue-300 border border-blue-800 font-mono">
              Híbrido IA
            </span>
          </div>

          <!-- Botón de Ejecución Principal -->
          <div class="pt-2">
            <button id="btnRunFacebookEngage" onclick="runFacebookEngagement()" 
                    class="w-full py-3 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 active:scale-98 text-white text-sm font-bold rounded-xl shadow-lg shadow-blue-600/30 flex items-center justify-center space-x-2 transition cursor-pointer">
              <i data-lucide="play" class="w-4 h-4"></i>
              <span>Iniciar Automatización en Facebook</span>
            </button>
            <p class="text-[11px] text-slate-400 text-center mt-2">
              Abre el post, desliza para revelar iconos, toma captura para que la IA la vea y genere el comentario, da Like y comenta.
            </p>
          </div>
        </div>

      </div>

      <!-- TAB: SIMULADOR DE COMENTARIOS & NARRATIVAS -->
      <div id="tabSimContent" class="hidden flex-1 flex flex-col space-y-4 min-h-[500px]">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="p-1.5 bg-gradient-to-tr from-amber-500 to-rose-600 rounded-lg shadow-md shadow-amber-500/20">
              <i data-lucide="sparkles" class="w-4 h-4 text-white"></i>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-slate-200">Simulador de Comentarios & Narrativas</h3>
              <p class="text-[11px] text-slate-400">Prueba cómo responderá la IA antes de lanzar la automatización</p>
            </div>
          </div>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800">
            Sin Género · No "Yo" · 6 Arquetipos MTY
          </span>
        </div>

        <!-- Input Box for Publication Text -->
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-4 space-y-3">
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label class="text-xs font-semibold text-slate-300 flex items-center space-x-1.5">
                <i data-lucide="copy" class="w-3.5 h-3.5 text-sky-400"></i>
                <span>Texto de la Publicación de Instagram:</span>
              </label>
              <div class="flex items-center space-x-2">
                <button type="button" onclick="captureAndReadForSimulator()" class="text-[10px] text-sky-400 hover:text-sky-300 flex items-center space-x-1 cursor-pointer font-medium">
                  <i data-lucide="camera" class="w-3 h-3"></i>
                  <span>📸 Capturar del teléfono</span>
                </button>
                <span class="text-[10px] text-slate-500">· O copia y pega</span>
              </div>
            </div>
            <textarea id="simPostText" rows="3" 
                      class="w-full bg-slate-900 border border-slate-700/80 rounded-xl px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-amber-500 placeholder-slate-500 resize-none font-sans leading-relaxed"
                      placeholder="Ejemplo: 'Terminando el entrenamiento matutino en Chipinque con toda la actitud. ¿Cuál es su rutina favorita para empezar el fin de semana?'"></textarea>
          </div>

          <!-- Contest / Giveaway Dynamic Mode Toggle -->
          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-2.5 space-y-2">
            <div class="flex items-center justify-between">
              <label class="flex items-center space-x-2 text-xs font-semibold text-slate-300 cursor-pointer">
                <input type="checkbox" id="simIsContest" onchange="toggleSimContestFields(this.checked)" class="rounded bg-slate-800 border-slate-700 text-amber-500 focus:ring-amber-500">
                <span class="flex items-center space-x-1.5">
                  <span class="text-amber-400">🏆</span>
                  <span class="text-[11px]">Modo Concurso / Dinámica (Pronóstico o Sorteo)</span>
                </span>
              </label>
              <span class="text-[10px] text-slate-500">Ej. Tigres vs Rayados</span>
            </div>
            <div id="simContestFields" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1 border-t border-slate-800/60">
              <div>
                <label class="text-[10px] text-slate-400 block mb-1">Requisito a cumplir / Desafío:</label>
                <input type="text" id="simContestReq" 
                       class="w-full bg-slate-950 border border-slate-700/80 rounded-lg px-2.5 py-1.5 text-xs text-amber-300 focus:outline-none focus:border-amber-500" 
                       placeholder="Comenta tu pronóstico para el Clásico Regio 143: Tigres vs Rayados"
                       value="Comenta tu pronóstico para el Clásico Regio 143: Tigres vs Rayados">
              </div>
              <div>
                <label class="text-[10px] text-slate-400 block mb-1">Tema / Partido / Consigna:</label>
                <input type="text" id="simContestTopic" 
                       class="w-full bg-slate-950 border border-slate-700/80 rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-amber-500" 
                       placeholder="Tigres vs Rayados (Clásico Regio 143)"
                       value="Tigres vs Rayados (Clásico Regio 143)">
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
            <div class="space-y-1">
              <label class="text-[11px] font-medium text-slate-400 flex items-center space-x-1">
                <i data-lucide="target" class="w-3.5 h-3.5 text-rose-400"></i>
                <span>Narrativa / Postura:</span>
              </label>
              <select id="simNarrativeSelect" class="w-full bg-slate-900 border border-slate-700/80 text-xs text-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:border-rose-500">
                <option value="a_favor" selected>👍 A favor / Apoyo entusiasta</option>
                <option value="participacion">💬 De participación / Pregunta</option>
                <option value="hate">⚡ Crítico / Hate / Desacuerdo</option>
                <option value="neutro">⚖️ Neutro / Observación</option>
              </select>
            </div>

            <div class="space-y-1">
              <label class="text-[11px] font-medium text-slate-400 flex items-center space-x-1">
                <span>🧠</span>
                <span>Arquetipo a probar:</span>
              </label>
              <select id="simArchetypeSelect" class="w-full bg-slate-900 border border-slate-700/80 text-xs text-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:border-amber-500">
                <optgroup label="✨ 5 Arquetipos Humanos (agents.md)">
                  <option value="human_all" selected>✨ Los 5 Arquetipos Humanos (Rotación)</option>
                  <option value="Testigo Silencioso">👁️ Testigo Silencioso</option>
                  <option value="Buscador">🔍 Buscador</option>
                  <option value="Guerrero Interior">⚔️ Guerrero Interior</option>
                  <option value="Caminante">🚶 Caminante</option>
                  <option value="Heredero">🏛️ Heredero</option>
                </optgroup>
                <optgroup label="🤠 Arquetipos Regionales Regiomontanos">
                  <option value="all">🎲 Todos los Regiomontanos (1 al 6)</option>
                  <option value="1">1. El Escéptico ("Chale")</option>
                  <option value="2">2. El Animador ("Fierro")</option>
                  <option value="3">3. El Consejero ("Morro")</option>
                  <option value="4">4. El Realista ("Está cañón")</option>
                  <option value="5">5. El Guardián ("Ponte trucha")</option>
                  <option value="6">6. El Auténtico ("La neta")</option>
                </optgroup>
              </select>
            </div>

            <div class="flex items-end">
              <button id="btnRunPreview" onclick="previewComments()" 
                      class="w-full py-2 px-3 bg-gradient-to-r from-amber-500 via-orange-500 to-rose-600 hover:from-amber-600 hover:to-rose-700 active:scale-98 text-white font-bold text-xs rounded-xl shadow-lg shadow-orange-600/20 flex items-center justify-center space-x-2 transition cursor-pointer">
                <i data-lucide="sparkles" id="simBtnIcon" class="w-4 h-4"></i>
                <span id="simBtnText">Simular Comentarios</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Simulation Results Cards Container -->
        <div id="simResultsContainer" class="space-y-3 overflow-y-auto max-h-[560px] pr-1">
          <div id="simEmptyPlaceholder" class="h-44 border-2 border-dashed border-slate-800 rounded-2xl flex flex-col items-center justify-center text-slate-500 p-4 text-center">
            <i data-lucide="bot" class="w-8 h-8 mb-2 text-slate-600"></i>
            <p class="text-xs font-medium text-slate-400">No se han simulado comentarios todavía</p>
            <p class="text-[11px] text-slate-600 mt-1">Pega el texto de cualquier publicación arriba, elige una narrativa y presiona "Simular Comentarios"</p>
          </div>
        </div>
      </div>

      <!-- TAB 2: TERMINAL LOGS -->
      <div id="tabTerminalContent" class="hidden flex-1 flex flex-col space-y-3 min-h-[500px]">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2 text-xs text-slate-400">
            <i data-lucide="code-2" class="w-4 h-4 text-emerald-400"></i>
            <span>Live Process Output (SSE)</span>
          </div>
          <button onclick="clearTerminal()" class="text-xs text-slate-500 hover:text-slate-400">Clear</button>
        </div>
        <div id="terminalContainer" class="flex-1 bg-slate-950 border border-slate-800 rounded-2xl p-4 font-mono text-xs overflow-y-auto max-h-[640px] space-y-1.5 select-text">
          <div class="text-slate-500">// Connected to Automator Log Stream...</div>
        </div>
      </div>

      <!-- TAB 3: SAVED RESULTS JSON -->
      <div id="tabHistoryContent" class="hidden flex-1 flex flex-col space-y-3 min-h-[500px]">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2 text-xs text-slate-400">
            <i data-lucide="file-json" class="w-4 h-4 text-amber-400"></i>
            <span>Local file: analysis_results.json</span>
          </div>
          <div class="flex space-x-2">
            <button onclick="loadSavedResults()" class="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-xs rounded-lg text-slate-300">Reload</button>
            <button onclick="downloadJsonResults()" class="px-3 py-1 bg-sky-600 hover:bg-sky-500 text-xs rounded-lg text-white font-medium">Export JSON</button>
          </div>
        </div>
        <pre id="jsonViewer" class="flex-1 bg-slate-950 border border-slate-800 rounded-2xl p-4 font-mono text-xs overflow-y-auto max-h-[640px] text-sky-300">
Loading results...
        </pre>
      </div>

      <!-- TAB 4: VISUAL ICON MANAGER & TOUCH LAB -->
      <div id="tabIconsContent" class="hidden flex-1 flex flex-col space-y-4 min-h-[500px]">
        <!-- Header -->
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <div class="p-1.5 bg-gradient-to-tr from-rose-500 to-amber-500 rounded-lg">
              <i data-lucide="target" class="w-4 h-4 text-white"></i>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-slate-200">Localizador Visual de Iconos & Marcadores Rojos</h3>
              <p class="text-[11px] text-slate-400">OpenCV Multi-escala con soporte de recuadro rojo y fallback IA Qwen2.5-VL</p>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <span class="px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700 text-[10px] font-mono">
              📁 icon_targets/
            </span>
            <button onclick="loadIconTemplates()" class="p-1.5 hover:bg-slate-800 rounded-lg text-slate-400 hover:text-slate-200 transition" title="Recargar Iconos">
              <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        </div>

        <!-- UPLOAD CARD -->
        <div class="bg-slate-950/70 border border-slate-800/90 rounded-xl p-3.5 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-300 flex items-center space-x-1.5">
              <i data-lucide="upload-cloud" class="w-3.5 h-3.5 text-sky-400"></i>
              <span>Subir Nuevo Icono o Captura Marcada</span>
            </span>
            <span class="text-[10px] text-amber-400/90 bg-amber-950/40 border border-amber-800/40 px-2 py-0.5 rounded-full">
              Soporta recuadro rojo automático
            </span>
          </div>

          <form id="uploadIconForm" onsubmit="handleIconUpload(event)" class="grid grid-cols-1 md:grid-cols-12 gap-2 items-center">
            <div class="md:col-span-6">
              <input type="file" id="iconFileInput" accept="image/png,image/jpeg,image/webp" required
                     class="w-full text-xs text-slate-400 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-slate-200 hover:file:bg-slate-700 cursor-pointer bg-slate-900 rounded-lg border border-slate-800">
            </div>
            <div class="md:col-span-4">
              <input type="text" id="iconTemplateNameInput" placeholder="Nombre opcional (ej: mi_icono)"
                     class="w-full bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-rose-500">
            </div>
            <div class="md:col-span-2">
              <button type="submit" id="uploadIconBtn" class="w-full py-1.5 px-3 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-medium rounded-lg transition flex items-center justify-center space-x-1">
                <i data-lucide="upload" class="w-3 h-3"></i>
                <span>Subir</span>
              </button>
            </div>
          </form>

          <p class="text-[11px] text-slate-400 leading-relaxed">
            💡 <strong>Modo Marcador Rojo:</strong> Si subes una captura de pantalla del teléfono donde marcaste o encerraste con 
            <span class="text-rose-400 font-semibold">color rojo</span> el icono que deseas tocar, el sistema recortará 
            el icono automáticamente y lo usará como plantilla.
          </p>
        </div>

        <!-- TOUCH CONTROL BAR -->
        <div class="bg-slate-950/90 border border-slate-800/90 rounded-xl p-3.5 space-y-3">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
            <!-- Icon Selector -->
            <div class="md:col-span-5 space-y-1">
              <label class="text-[11px] font-medium text-slate-400">Icono a presionar en pantalla:</label>
              <select id="selectedIconTarget" onchange="onTargetIconChanged()" class="w-full bg-slate-900 border border-slate-800 text-xs text-slate-200 rounded-lg px-2.5 py-2 focus:outline-none focus:border-rose-500">
                <option value="">Cargando iconos...</option>
              </select>
            </div>

            <!-- Sleep Duration Slider & Value -->
            <div class="md:col-span-4 space-y-1">
              <div class="flex justify-between text-[11px]">
                <span class="text-slate-400 font-medium">Pausa posterior (Sleep):</span>
                <span id="sleepValueLabel" class="text-amber-400 font-bold">1.5 s</span>
              </div>
              <input type="range" id="iconSleepSlider" min="0.5" max="5.0" step="0.5" value="1.5"
                     oninput="document.getElementById('sleepValueLabel').textContent = this.value + ' s'"
                     class="w-full accent-rose-500 h-1.5 bg-slate-800 rounded-lg cursor-pointer">
            </div>

            <!-- Execute Touch Button -->
            <div class="md:col-span-3">
              <button type="button" id="locateAndTapBtn" onclick="runLocateAndTap()" class="w-full py-2 px-3 bg-gradient-to-r from-rose-600 via-amber-600 to-orange-600 hover:from-rose-500 hover:to-orange-500 text-white text-xs font-bold rounded-lg shadow-lg shadow-rose-600/20 flex items-center justify-center space-x-1.5 transition active:scale-98">
                <i data-lucide="crosshair" class="w-3.5 h-3.5"></i>
                <span>Buscar y Tocar</span>
              </button>
            </div>
          </div>

          <!-- Execution Status Feedback -->
          <div id="iconActionFeedback" class="hidden rounded-lg p-2.5 text-xs flex items-center justify-between border">
            <div class="flex items-center space-x-2">
              <span id="iconFeedbackDot" class="w-2 h-2 rounded-full"></span>
              <span id="iconFeedbackText" class="font-medium"></span>
            </div>
            <button id="viewDebugMatchBtn" onclick="toggleDebugMatchModal()" class="hidden text-[11px] underline text-sky-400 hover:text-sky-300">
              Ver Detección Visual
            </button>
          </div>
        </div>

        <!-- TEMPLATE GALLERY -->
        <div class="flex-1 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-300">Iconos disponibles en icon_targets/</span>
            <span id="templatesCountBadge" class="text-[11px] text-slate-500">0 iconos</span>
          </div>

          <div id="iconGalleryGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 max-h-[380px] overflow-y-auto pr-1">
            <!-- Icon Cards dynamically populated -->
          </div>
        </div>
      </div>

      <!-- VISUAL MATCH DEBUG MODAL -->
      <div id="debugMatchModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-4 space-y-3 shadow-2xl flex flex-col">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <div class="flex items-center space-x-2">
              <i data-lucide="scan" class="w-4 h-4 text-emerald-400"></i>
              <h4 class="text-sm font-semibold text-slate-200">Detección Visual en Pantalla</h4>
            </div>
            <button onclick="toggleDebugMatchModal()" class="p-1 text-slate-400 hover:text-slate-200 rounded-lg">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
          <div class="bg-slate-950 rounded-xl overflow-hidden flex items-center justify-center max-h-[480px]">
            <img id="debugMatchImg" src="/api/icons/debug-image" alt="Visual Match Debug" class="object-contain max-h-[460px] w-auto">
          </div>
          <p class="text-[11px] text-slate-400 text-center">
            🟩 Recuadro verde: Bounding box de coincidencia • 🔴 Cruz roja: Centro del toque (touch)
          </p>
        </div>
      </div>

      <!-- CAPTURED SCREEN FULL MODAL -->
      <div id="screenModal" class="hidden fixed inset-0 bg-slate-950/85 backdrop-blur-sm z-50 flex items-center justify-center p-4" onclick="closeScreenModal(event)">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-sm w-full p-4 space-y-3 shadow-2xl flex flex-col" onclick="event.stopPropagation()">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <div class="flex items-center space-x-2">
              <i data-lucide="camera" class="w-4 h-4 text-sky-400"></i>
              <h4 class="text-sm font-semibold text-slate-200">Captura de Pantalla</h4>
            </div>
            <button onclick="closeScreenModal()" class="p-1 text-slate-400 hover:text-slate-200 rounded-lg cursor-pointer">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
          <div class="bg-slate-950 rounded-xl overflow-hidden flex items-center justify-center max-h-[560px]">
            <img id="modalScreenImg" src="" alt="Captura de Pantalla" class="object-contain max-h-[540px] w-auto">
          </div>
          <p class="text-[11px] text-slate-400 text-center">
            Captura del dispositivo móvil leída por IA
          </p>
        </div>
      </div>

      <!-- MEMORY LOG MODAL (agents.md) -->
      <div id="memoryModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4" onclick="closeMemoryModal()">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-2xl w-full p-4 space-y-3 shadow-2xl flex flex-col max-h-[85vh]" onclick="event.stopPropagation()">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <div class="flex items-center space-x-2">
              <i data-lucide="brain" class="w-4 h-4 text-amber-400"></i>
              <h4 class="text-sm font-semibold text-slate-200">Memoria Persistente del Agente (<span class="font-mono text-amber-400">agents.md</span>)</h4>
            </div>
            <button onclick="closeMemoryModal()" class="p-1 text-slate-400 hover:text-slate-200 rounded-lg cursor-pointer">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>

          <div id="memorySummaryHeader" class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 text-xs space-y-1">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-slate-400 font-medium">Últimos arquetipos usados (Rotación activa):</span>
              <span id="memoryRecentArchs" class="text-amber-300 font-mono font-bold">Cargando...</span>
            </div>
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-slate-400 font-medium">Elementos visuales citados:</span>
              <span id="memoryRecentElems" class="text-teal-300 font-mono">Cargando...</span>
            </div>
          </div>

          <div class="flex-1 bg-slate-950 rounded-xl p-3 border border-slate-800/80 overflow-y-auto font-mono text-[11px] text-slate-300 select-text leading-relaxed whitespace-pre-wrap max-h-[50vh]" id="memoryRawContent">
            Cargando historial de agents.md...
          </div>

          <div class="flex items-center justify-between pt-1 text-[11px] text-slate-400">
            <span>Reglas: Máx 3 líneas · Cero emojis · Rotación 5 Arquetipos</span>
            <button onclick="refreshMemoryModal()" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg transition cursor-pointer">
              Actualizar
            </button>
          </div>
        </div>
      </div>
  </main>

  <!-- JAVASCRIPT APP LOGIC -->
  <script>
    let totalPostsCount = 0;
    let autoRefreshInterval = null;
    let savedResultsCache = [];

    // Initialize Lucide icons, scan local models, and load icon templates
    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();
      pollStatus();
      setInterval(pollStatus, 4000);
      setupAutoRefresh();
      connectEventStream();
      scanLocalModels(false);
      loadIconTemplates();

      try {
        const savedComments = localStorage.getItem("granjita_pasted_comments");
        if (savedComments) {
          const ta = document.getElementById("pastedCommentsTextarea");
          if (ta) {
            ta.value = savedComments;
            updatePastedCommentsCount();
          }
        }
      } catch (e) {}
    });

    function toggleSimContestFields(checked) {
      const container = document.getElementById("simContestFields");
      if (container) {
        if (checked) container.classList.remove("hidden");
        else container.classList.add("hidden");
      }
    }

    // Auto-refresh / Live stream setup
    function setupAutoRefresh() {
      const toggle = document.getElementById("autoRefreshToggle");
      if (!toggle) return;
      const img = document.getElementById("deviceScreen");
      
      toggle.addEventListener("change", (e) => {
        if (e.target.checked) {
          img.src = `/api/device/stream?t=${Date.now()}`;
        } else {
          img.src = `/api/screen?t=${Date.now()}`;
        }
      });
    }

    // Refresh Device Screen
    function refreshScreen(showSpinner = true) {
      const img = document.getElementById("deviceScreen");
      const spinner = document.getElementById("screenSpinner");
      if (showSpinner && spinner) spinner.classList.remove("hidden");

      const toggle = document.getElementById("autoRefreshToggle");
      if (toggle && toggle.checked) {
        img.src = `/api/device/stream?t=${Date.now()}`;
      } else {
        img.src = `/api/screen?t=${Date.now()}`;
      }
    }

    async function takeManualCapture() {
      const spinner = document.getElementById("screenSpinner");
      if (spinner) spinner.classList.remove("hidden");
      try {
        await fetch("/api/manual/capture", { method: "POST" });
      } catch (e) {
        console.error("Capture error:", e);
      }
      refreshScreen(false);
    }

    function onScreenLoadSuccess(img) {
      const spinner = document.getElementById("screenSpinner");
      const placeholder = document.getElementById("screenPlaceholder");
      if (spinner) spinner.classList.add("hidden");
      if (placeholder) placeholder.classList.add("hidden");
      img.classList.remove("hidden");
    }

    let screenRetryTimer = null;
    function onScreenLoadError(img) {
      const spinner = document.getElementById("screenSpinner");
      const placeholder = document.getElementById("screenPlaceholder");
      if (spinner) spinner.classList.add("hidden");
      if (placeholder) placeholder.classList.remove("hidden");
      
      clearTimeout(screenRetryTimer);
      screenRetryTimer = setTimeout(() => {
        const toggle = document.getElementById("autoRefreshToggle");
        const baseSrc = (toggle && toggle.checked) ? "/api/device/stream" : "/api/screen";
        img.src = `${baseSrc}?t=${Date.now()}`;
      }, 1800);
    }

    // Preset button helper
    function setAppPackage(pkg) {
      document.getElementById("packageNameInput").value = pkg;
    }

    // Tab Switching
    function switchTab(tab) {
      const feedBtn = document.getElementById("tabFeedBtn");
      const commentsBtn = document.getElementById("tabCommentsBtn");
      const fbBtn = document.getElementById("tabFacebookBtn");
      const simBtn = document.getElementById("tabSimBtn");
      const iconsBtn = document.getElementById("tabIconsBtn");
      const termBtn = document.getElementById("tabTerminalBtn");
      const histBtn = document.getElementById("tabHistoryBtn");

      const feedContent = document.getElementById("tabFeedContent");
      const commentsContent = document.getElementById("tabCommentsContent");
      const fbContent = document.getElementById("tabFacebookContent");
      const simContent = document.getElementById("tabSimContent");
      const iconsContent = document.getElementById("tabIconsContent");
      const termContent = document.getElementById("tabTerminalContent");
      const histContent = document.getElementById("tabHistoryContent");

      const activeClasses = ["bg-sky-600", "text-white", "shadow"];
      const fbActiveClasses = ["bg-blue-600", "text-white", "shadow"];
      const inactiveClasses = ["text-slate-400", "hover:text-slate-200"];

      [feedBtn, commentsBtn, fbBtn, simBtn, iconsBtn, termBtn, histBtn].forEach(b => {
        if (b) {
          b.classList.remove(...activeClasses, ...fbActiveClasses);
          b.classList.add(...inactiveClasses);
        }
      });
      [feedContent, commentsContent, fbContent, simContent, iconsContent, termContent, histContent].forEach(c => {
        if (c) c.classList.add("hidden");
      });

      if (tab === 'feed') {
        feedBtn.classList.add(...activeClasses);
        feedBtn.classList.remove(...inactiveClasses);
        feedContent.classList.remove("hidden");
      } else if (tab === 'comments') {
        commentsBtn.classList.add(...activeClasses);
        commentsBtn.classList.remove(...inactiveClasses);
        commentsContent.classList.remove("hidden");
      } else if (tab === 'facebook') {
        if (fbBtn) {
          fbBtn.classList.add(...fbActiveClasses);
          fbBtn.classList.remove(...inactiveClasses);
        }
        if (fbContent) fbContent.classList.remove("hidden");
      } else if (tab === 'sim') {
        simBtn.classList.add(...activeClasses);
        simBtn.classList.remove(...inactiveClasses);
        simContent.classList.remove("hidden");
      } else if (tab === 'icons') {
        iconsBtn.classList.add(...activeClasses);
        iconsBtn.classList.remove(...inactiveClasses);
        iconsContent.classList.remove("hidden");
        loadIconTemplates();
      } else if (tab === 'terminal') {
        termBtn.classList.add(...activeClasses);
        termBtn.classList.remove(...inactiveClasses);
        termContent.classList.remove("hidden");
      } else if (tab === 'history') {
        histBtn.classList.add(...activeClasses);
        histBtn.classList.remove(...inactiveClasses);
        histContent.classList.remove("hidden");
        loadSavedResults();
      }
      if (window.lucide) lucide.createIcons();
    }

    // --- FACEBOOK AUTOMATOR HELPERS ---
    function renderFacebookDetectedElements(els) {
      if (!els) return;
      const logEl = document.getElementById("fbScanLog");

      // Actualizar tarjeta Like
      const cLike = document.getElementById("fbCoordLike");
      const iLike = document.getElementById("fbIconLike");
      if (cLike && iLike) {
        if (els.like_button) {
          cLike.textContent = `(${els.like_button.center[0]}, ${els.like_button.center[1]})`;
          cLike.className = "text-[10px] text-emerald-400 font-mono mt-0.5 font-bold";
          iLike.className = "w-5 h-5 text-emerald-400 mb-1";
        } else {
          cLike.textContent = "No detectado";
          cLike.className = "text-[10px] text-slate-500 font-mono mt-0.5";
          iLike.className = "w-5 h-5 text-slate-500 mb-1";
        }
      }

      // Actualizar tarjeta Comentar
      const cComm = document.getElementById("fbCoordComment");
      const iComm = document.getElementById("fbIconComment");
      if (cComm && iComm) {
        if (els.comment_button) {
          cComm.textContent = `(${els.comment_button.center[0]}, ${els.comment_button.center[1]})`;
          cComm.className = "text-[10px] text-emerald-400 font-mono mt-0.5 font-bold";
          iComm.className = "w-5 h-5 text-emerald-400 mb-1";
        } else {
          cComm.textContent = "No detectado";
          cComm.className = "text-[10px] text-slate-500 font-mono mt-0.5";
          iComm.className = "w-5 h-5 text-slate-500 mb-1";
        }
      }

      // Actualizar tarjeta Input
      const cInp = document.getElementById("fbCoordInput");
      const iInp = document.getElementById("fbIconInput");
      if (cInp && iInp) {
        if (els.input_box) {
          cInp.textContent = `(${els.input_box.center[0]}, ${els.input_box.center[1]})`;
          cInp.className = "text-[10px] text-emerald-400 font-mono mt-0.5 font-bold";
          iInp.className = "w-5 h-5 text-emerald-400 mb-1";
        } else {
          cInp.textContent = "No detectado";
          cInp.className = "text-[10px] text-slate-500 font-mono mt-0.5";
          iInp.className = "w-5 h-5 text-slate-500 mb-1";
        }
      }

      // Actualizar tarjeta Send
      const cSend = document.getElementById("fbCoordSend");
      const iSend = document.getElementById("fbIconSend");
      if (cSend && iSend) {
        if (els.send_button) {
          cSend.textContent = `(${els.send_button.center[0]}, ${els.send_button.center[1]})`;
          cSend.className = "text-[10px] text-emerald-400 font-mono mt-0.5 font-bold";
          iSend.className = "w-5 h-5 text-emerald-400 mb-1";
        } else {
          cSend.textContent = "No detectado";
          cSend.className = "text-[10px] text-slate-500 font-mono mt-0.5";
          iSend.className = "w-5 h-5 text-slate-500 mb-1";
        }
      }

      if (logEl) {
        logEl.classList.remove("hidden");
        const foundCount = [els.like_button, els.comment_button, els.input_box, els.send_button].filter(Boolean).length;
        logEl.textContent = `Escaneo completado: ${foundCount} de 4 elementos identificados en la pantalla de Facebook.`;
      }
    }

    async function testOpenFacebookPost() {
      const urlInput = document.getElementById("fbUrlInput");
      const url = urlInput ? urlInput.value.trim() : "";
      const useCurrent = document.getElementById("fbUseCurrentScreen")?.checked || false;
      const pkgEl = document.querySelector('input[name="fbPackageChoice"]:checked');
      const pkg = pkgEl ? pkgEl.value : "com.facebook.katana";
      const autoScroll = document.getElementById("fbAutoScroll")?.checked ?? true;
      const scrollPixels = parseInt(document.getElementById("fbScrollPixels")?.value || "280", 10);
      const waitAfter = parseFloat(document.getElementById("fbWaitAfterScroll")?.value || "2.5");
      const autoScan = document.getElementById("fbAutoScan")?.checked ?? true;

      if (!url && !useCurrent) {
        showToast("Ingresa el enlace de Facebook o marca 'Usar pantalla actual'.", "error");
        return;
      }

      const openBtn = event?.currentTarget || document.querySelector("button[onclick='testOpenFacebookPost()']");
      const origText = openBtn ? openBtn.innerHTML : "";
      if (openBtn) {
        openBtn.disabled = true;
        openBtn.innerHTML = `<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i><span>Abriendo y preparando...</span>`;
        if (window.lucide) lucide.createIcons();
      }

      showToast(`Abriendo en Facebook (${pkg})... cargando, deslizando y estabilizando...`, "info");
      try {
        const res = await fetch("/api/facebook/open-post", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            url: url,
            package: pkg,
            use_current_screen: useCurrent,
            auto_scroll: autoScroll,
            scroll_pixels: scrollPixels,
            wait_after_scroll: waitAfter,
            auto_scan: autoScan
          })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message || "Publicación abierta y lista.", "success");
          setTimeout(() => takeManualCapture(), 500);
          if (data.detected_elements) {
            renderFacebookDetectedElements(data.detected_elements);
          }
        } else {
          showToast(data.error || "Error al abrir enlace en Facebook.", "error");
        }
      } catch (err) {
        showToast("Error de conexión al abrir en Facebook: " + err.message, "error");
      } finally {
        if (openBtn) {
          openBtn.disabled = false;
          openBtn.innerHTML = origText;
          if (window.lucide) lucide.createIcons();
        }
      }
    }

    async function fbManualGentleScroll() {
      const scrollPixels = parseInt(document.getElementById("fbScrollPixels")?.value || "280", 10);
      const waitAfter = parseFloat(document.getElementById("fbWaitAfterScroll")?.value || "2.5");
      const autoScan = document.getElementById("fbAutoScan")?.checked ?? true;

      showToast(`Deslizando suavemente ${scrollPixels}px para revelar iconos...`, "info");
      try {
        const res = await fetch("/api/facebook/scroll", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ pixels: scrollPixels, wait_after: waitAfter })
        });
        const data = await res.json();
        if (data.success) {
          showToast("Deslizamiento completado e iconos alineados.", "success");
          setTimeout(() => takeManualCapture(), 500);
          if (autoScan) {
            scanFacebookUI();
          }
        } else {
          showToast(data.error || "Error al deslizar.", "error");
        }
      } catch (err) {
        showToast("Error al realizar deslizamiento: " + err.message, "error");
      }
    }

    async function scanFacebookUI() {
      const btn = document.getElementById("btnScanFacebookUI");
      const pkgEl = document.querySelector('input[name="fbPackageChoice"]:checked');
      const pkg = pkgEl ? pkgEl.value : "com.facebook.katana";

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i><span>Escaneando...</span>`;
        if (window.lucide) lucide.createIcons();
      }

      try {
        const res = await fetch("/api/facebook/scan-ui", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ package: pkg })
        });
        const data = await res.json();
        if (data.success) {
          renderFacebookDetectedElements(data.detected_elements);
          showToast("Escaneo de interfaz de Facebook completado.", "success");
        } else {
          showToast(data.error || "No se pudo escanear la pantalla.", "error");
        }
      } catch (err) {
        showToast("Error al escanear UI de Facebook: " + err.message, "error");
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = `<i data-lucide="crosshair" class="w-3.5 h-3.5"></i><span>Escanear Botones Actuales</span>`;
          if (window.lucide) lucide.createIcons();
        }
      }
    }

    async function runFacebookEngagement() {
      const urlInput = document.getElementById("fbUrlInput");
      const url = urlInput ? urlInput.value.trim() : "";
      const useCurrent = document.getElementById("fbUseCurrentScreen")?.checked || false;
      const pkgEl = document.querySelector('input[name="fbPackageChoice"]:checked');
      const pkg = pkgEl ? pkgEl.value : "com.facebook.katana";
      const autoScroll = document.getElementById("fbAutoScroll")?.checked ?? true;
      const scrollPixels = parseInt(document.getElementById("fbScrollPixels")?.value || "280", 10);
      const waitAfter = parseFloat(document.getElementById("fbWaitAfterScroll")?.value || "2.5");
      const doLike = document.getElementById("fbDoLike")?.checked ?? true;
      const doComment = document.getElementById("fbDoComment")?.checked ?? true;

      // Extraer comentarios pegados de la columna derecha si existen
      const pastedText = document.getElementById("pastedCommentsTextarea")?.value || "";
      const pastedComments = pastedText.split("\n").map(s => s.trim()).filter(Boolean);
      const isPreset = document.getElementById("commentModePreset")?.checked;
      const commentMode = (isPreset && pastedComments.length > 0) ? "preset_list" : "auto";

      // Contexto de la Publicación (desde el panel de contexto a la izquierda)
      const manualContext = document.getElementById("manualContextPostText")?.value.trim() || "";
      const isContest = document.getElementById("manualContextIsContest")?.checked ?? false;
      const contestReq = document.getElementById("manualContextContestReq")?.value.trim() || "";
      const contestTopic = document.getElementById("manualContextContestTopic")?.value.trim() || "";
      const customComment = document.getElementById("cycleCustomComment")?.value.trim() || "";
      const narrative = document.getElementById("cycleNarrativeSelect")?.value || "a_favor";

      if (!url && !useCurrent) {
        showToast("Ingresa el enlace de Facebook o activa 'Usar pantalla actual'.", "error");
        return;
      }

      const btn = document.getElementById("btnRunFacebookEngage");
      const origHtml = btn ? btn.innerHTML : "";
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>Automatizando en Facebook...</span>`;
        if (window.lucide) lucide.createIcons();
      }

      showToast(`Iniciando automatización en Facebook (${pkg})...`, "info");
      try {
        const res = await fetch("/api/facebook/run-engage", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            url: url,
            package: pkg,
            use_current_screen: useCurrent,
            auto_scroll: autoScroll,
            scroll_pixels: scrollPixels,
            wait_after_scroll: waitAfter,
            do_like: doLike,
            do_comment: doComment,
            comment_mode: commentMode,
            pasted_comments: pastedComments,
            manual_context: manualContext,
            is_contest: isContest,
            contest_requirement: contestReq,
            teams_or_topic: contestTopic,
            custom_comment: customComment,
            narrative: narrative
          })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message || "Proceso de Facebook iniciado con éxito.", "success");
        } else {
          showToast(data.error || "Error al iniciar proceso.", "error");
        }
      } catch (err) {
        showToast("Error de conexión: " + err.message, "error");
      } finally {
        setTimeout(() => {
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = origHtml;
            if (window.lucide) lucide.createIcons();
          }
        }, 3500);
      }
    }

    // Poll Status (Device, Ollama, Manager)
    async function pollStatus() {
      try {
        const res = await fetch("/api/status");
        const data = await res.json();

        // Update Device badge
        const devDot = document.getElementById("deviceDot");
        const devText = document.getElementById("deviceText");
        if (data.device.connected) {
          devDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400";
          devText.innerText = "ADB Connected";
        } else {
          devDot.className = "w-2.5 h-2.5 rounded-full bg-rose-500";
          devText.innerText = "No ADB Device";
        }

        // Update Ollama badge
        const olDot = document.getElementById("ollamaDot");
        const olText = document.getElementById("ollamaText");
        if (data.ollama.online) {
          const hasV = data.ollama.has_vision;
          const hasT = data.ollama.has_text;
          if (hasV && hasT) {
            olDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-400";
            olText.innerText = "Ollama Ready";
          } else {
            olDot.className = "w-2.5 h-2.5 rounded-full bg-amber-400";
            olText.innerText = "Ollama (Missing Models)";
          }
        } else {
          olDot.className = "w-2.5 h-2.5 rounded-full bg-rose-500";
          olText.innerText = "Ollama Offline";
        }

        if (data.config && data.config.vision_model && data.config.text_model) {
          updateActiveModelLabels(data.config.vision_model, data.config.text_model);
        }

        // Update Automation State
        updateStateBadge(data.automation.state);

      } catch (err) {
        console.warn("Status poll error:", err);
      }
    }

    function updateStateBadge(state) {
      const badge = document.getElementById("stateBadge");
      const dot = document.getElementById("stateDot");
      const text = document.getElementById("stateText");
      const startBtn = document.getElementById("startBtn");
      const stopBtn = document.getElementById("stopBtn");

      text.innerText = state;

      if (state === "RUNNING") {
        dot.className = "w-2.5 h-2.5 rounded-full bg-sky-400 animate-ping";
        badge.className = "flex items-center space-x-2 px-3 py-1.5 rounded-full bg-sky-950 border border-sky-600 text-xs font-semibold text-sky-300";
        startBtn.disabled = true;
        startBtn.classList.add("opacity-50", "cursor-not-allowed");
        stopBtn.disabled = false;
      } else if (state === "STOPPING") {
        dot.className = "w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse";
        badge.className = "flex items-center space-x-2 px-3 py-1.5 rounded-full bg-amber-950 border border-amber-600 text-xs font-semibold text-amber-300";
        startBtn.disabled = true;
        stopBtn.disabled = true;
      } else if (state === "ERROR") {
        dot.className = "w-2.5 h-2.5 rounded-full bg-rose-500";
        badge.className = "flex items-center space-x-2 px-3 py-1.5 rounded-full bg-rose-950 border border-rose-600 text-xs font-semibold text-rose-300";
        startBtn.disabled = false;
        startBtn.classList.remove("opacity-50", "cursor-not-allowed");
        stopBtn.disabled = true;
      } else {
        // IDLE
        dot.className = "w-2.5 h-2.5 rounded-full bg-slate-500";
        badge.className = "flex items-center space-x-2 px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 text-xs font-semibold text-slate-300";
        startBtn.disabled = false;
        startBtn.classList.remove("opacity-50", "cursor-not-allowed");
        stopBtn.disabled = true;
      }
    }

    // Connect SSE stream
    function connectEventStream() {
      const source = new EventSource("/api/logs/stream");

      source.onmessage = (event) => {
        try {
          const payload = JSON.parse(event.data);

          if (payload.type === "log") {
            appendLog(payload);
          } else if (payload.type === "screen_updated") {
            refreshScreen(false);
          } else if (payload.type === "status_change") {
            updateStateBadge(payload.data.state);
          } else if (payload.type === "new_analysis") {
            renderAnalysisCard(payload.data);
          } else if (payload.type === "cycle_step") {
            handleCycleStep(payload.data);
          } else if (payload.type === "cycle_error") {
            handleCycleError(payload.data);
          } else if (payload.type === "post_engage_step") {
            handleCycleStep(payload.data);
          } else if (payload.type === "post_analyzed") {
            handlePostAnalyzed(payload.data);
          } else if (payload.type === "comment_generated") {
            const cInput = document.getElementById("cycleCustomComment");
            if (cInput && !cInput.value) cInput.value = payload.data.comment;
            const cBox = document.getElementById("cycleCommentBox");
            const cArch = document.getElementById("cycleCommentArchLabel");
            const cContent = document.getElementById("cycleCommentContent");
            if (cBox && cContent) {
              cBox.classList.remove("hidden");
              cContent.innerText = `"${payload.data.comment}"`;
              if (cArch && payload.data.archetype) {
                cArch.innerHTML = `<i data-lucide="sparkles" class="w-3 h-3 text-amber-400"></i> <span>[${payload.data.archetype.regionalism}] ${payload.data.archetype.name}</span>`;
                if (window.lucide) lucide.createIcons();
              }
            }
          } else if (payload.type === "models_updated") {
            updateActiveModelLabels(payload.data.vision_model, payload.data.text_model);
          }
        } catch (e) {
          // heartbeat or non-JSON
        }
      };

      source.onerror = () => {
        console.warn("SSE stream disconnected. Reconnecting in 3s...");
      };
    }

    // Append to Terminal Log
    function appendLog(log) {
      const container = document.getElementById("terminalContainer");
      const line = document.createElement("div");

      let color = "text-slate-300";
      if (log.level === "WARNING") color = "text-amber-400";
      if (log.level === "ERROR" || log.level === "CRITICAL") color = "text-rose-400";
      if (log.level === "INFO" && log.message.includes("Iteration")) color = "text-sky-400 font-semibold";

      line.className = `${color} break-all`;
      line.innerHTML = `<span class="text-slate-600">[${log.timestamp}]</span> ${escapeHtml(log.message)}`;
      container.appendChild(line);
      container.scrollTop = container.scrollHeight;
    }

    function clearTerminal() {
      document.getElementById("terminalContainer").innerHTML = '<div class="text-slate-500">// Terminal cleared.</div>';
    }

    // Render Analyzed Post Card
    function renderAnalysisCard(data) {
      const empty = document.getElementById("feedEmptyState");
      if (empty) empty.classList.add("hidden");

      const container = document.getElementById("feedCardsContainer");
      const vision = data.vision_data || {};
      const posts = vision.posts || [];
      const textAnalysis = data.text_analysis?.analysis || [];
      const reasoning = vision.reasoning || "No reasoning provided";
      const iterNum = data.iteration || 1;

      posts.forEach((post, i) => {
        totalPostsCount++;
        const analysis = textAnalysis[i] || {};
        const sentiment = analysis.sentiment || "Neutral";
        const topic = analysis.topic || "General";
        const action = analysis.action || "None";

        let sentBadge = "bg-sky-950/80 text-sky-300 border-sky-700/60";
        if (sentiment.toLowerCase().includes("pos")) sentBadge = "bg-emerald-950/80 text-emerald-300 border-emerald-700/60";
        if (sentiment.toLowerCase().includes("neg")) sentBadge = "bg-rose-950/80 text-rose-300 border-rose-700/60";

        const card = document.createElement("div");
        card.className = "bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-2xl p-4 shadow-lg transition duration-200 flex flex-col space-y-3";
        card.innerHTML = `
          <div class="flex items-start justify-between">
            <div class="flex items-center space-x-2.5">
              <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-sky-600 to-indigo-600 flex items-center justify-center font-bold text-xs text-white">
                ${(post.author || "U")[0].toUpperCase()}
              </div>
              <div>
                <div class="text-sm font-semibold text-slate-200">@${escapeHtml(post.author || "unknown")}</div>
                <div class="text-[11px] text-slate-500">Iteration #${iterNum} • ${data.timestamp ? data.timestamp.substring(11, 19) : ''}</div>
              </div>
            </div>

            <div class="flex items-center space-x-1.5">
              ${post.is_ad 
                ? '<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-950/80 text-amber-300 border border-amber-800">SPONSORED / AD</span>' 
                : '<span class="px-2 py-0.5 rounded-md text-[10px] font-medium bg-emerald-950/60 text-emerald-400 border border-emerald-800/80">ORGANIC</span>'}
            </div>
          </div>

          <p class="text-xs text-slate-300 bg-slate-950/60 p-3 rounded-xl border border-slate-800/60 italic leading-relaxed">
            "${escapeHtml(post.content_snippet || 'No text snippet extracted.')}"
          </p>

          <div class="flex flex-wrap items-center gap-2 pt-1 text-xs">
            <!-- Topic Pill -->
            <span class="px-2.5 py-1 rounded-lg bg-indigo-950/60 border border-indigo-800/60 text-indigo-300 flex items-center space-x-1">
              <i data-lucide="tag" class="w-3 h-3"></i>
              <span>${escapeHtml(topic)}</span>
            </span>

            <!-- Sentiment Pill -->
            <span class="px-2.5 py-1 rounded-lg border ${sentBadge} flex items-center space-x-1">
              <i data-lucide="smile" class="w-3 h-3"></i>
              <span>${escapeHtml(sentiment)}</span>
            </span>

            <!-- Action Pill -->
            <span class="px-2.5 py-1 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 flex items-center space-x-1">
              <i data-lucide="zap" class="w-3 h-3 text-amber-400"></i>
              <span>Action: ${escapeHtml(action)}</span>
            </span>
          </div>
        `;

        container.prepend(card);
      });

      document.getElementById("postsCountBadge").innerText = `${totalPostsCount} posts`;
      lucide.createIcons();
    }

    function clearFeedCards() {
      document.getElementById("feedCardsContainer").innerHTML = `
        <div id="feedEmptyState" class="h-64 border-2 border-dashed border-slate-800 rounded-2xl flex flex-col items-center justify-center text-slate-500">
          <i data-lucide="scan-eye" class="w-10 h-10 mb-2 text-slate-600"></i>
          <p class="text-sm font-medium">Stream cleared</p>
        </div>
      `;
      totalPostsCount = 0;
      document.getElementById("postsCountBadge").innerText = "0 posts";
      lucide.createIcons();
    }

    // Automation Controls API
    async function startAutomation() {
      const pkg = document.getElementById("packageNameInput").value;
      const iters = document.getElementById("iterationsRange").value;
      const delay = document.getElementById("delayRange").value;

      try {
        const res = await fetch("/api/start", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ package_name: pkg, max_iterations: iters, scroll_wait: delay })
        });
        const data = await res.json();
        if (data.success) {
          updateStateBadge("RUNNING");
        } else {
          alert("Could not start: " + data.message);
        }
      } catch (err) {
        alert("API Error: " + err);
      }
    }

    async function stopAutomation() {
      try {
        await fetch("/api/stop", { method: "POST" });
        updateStateBadge("STOPPING");
      } catch (err) {
        alert("Stop request failed: " + err);
      }
    }

    async function manualScroll(direction) {
      try {
        await fetch("/api/manual/scroll", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ direction })
        });
      } catch (e) {
        console.error("Scroll error:", e);
      }
    }

    async function launchTargetApp() {
      const pkg = document.getElementById("packageNameInput").value;
      try {
        await fetch("/api/manual/open-app", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ package_name: pkg })
        });
      } catch (e) {
        console.error("Launch app error:", e);
      }
    }

    async function openUrlOnDevice() {
      const input = document.getElementById("urlInput");
      const btn = document.getElementById("openUrlBtn");
      const url = input.value.trim();

      if (!url) {
        alert("Por favor introduce una URL o enlace.");
        return;
      }

      btn.disabled = true;
      btn.classList.add("opacity-50");

      try {
        const res = await fetch("/api/manual/open-url", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url })
        });
        const data = await res.json();
        if (data.success) {
          setTimeout(() => refreshScreen(false), 1500);
        } else {
          alert("Error al abrir URL: " + (data.error || "No se pudo despachar el intent"));
        }
      } catch (e) {
        alert("Error de red: " + e);
      } finally {
        btn.disabled = false;
        btn.classList.remove("opacity-50");
      }
    }

    function setMediaType(type) {
      const input = document.getElementById("mediaTypeInput");
      const btnPost = document.getElementById("btnMediaTypePost");
      const btnReel = document.getElementById("btnMediaTypeReel");
      if (input) input.value = type;

      if (type === "reel") {
        if (btnReel) {
          btnReel.className = "px-2.5 py-1 rounded-md font-semibold text-[11px] transition flex items-center space-x-1 bg-violet-600/30 text-violet-300 border border-violet-500/50 shadow-sm";
        }
        if (btnPost) {
          btnPost.className = "px-2.5 py-1 rounded-md font-semibold text-[11px] transition flex items-center space-x-1 text-slate-400 hover:text-slate-200 border border-transparent";
        }
      } else {
        if (btnPost) {
          btnPost.className = "px-2.5 py-1 rounded-md font-semibold text-[11px] transition flex items-center space-x-1 bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-sm";
        }
        if (btnReel) {
          btnReel.className = "px-2.5 py-1 rounded-md font-semibold text-[11px] transition flex items-center space-x-1 text-slate-400 hover:text-slate-200 border border-transparent";
        }
      }
    }

    // Auto-detect Reel vs Post when pasting or typing URL
    document.addEventListener("DOMContentLoaded", () => {
      const urlInp = document.getElementById("urlInput");
      if (urlInp) {
        urlInp.addEventListener("input", (e) => {
          const val = (e.target.value || "").toLowerCase();
          if (val.includes("/reel/") || val.includes("/reels/")) {
            setMediaType("reel");
          } else if (val.includes("/p/")) {
            setMediaType("post");
          }
        });
      }
    });

    // Multi-Account Dynamic Cycle Automation
    async function startMultiAccountCycle() {
      const urlInput = document.getElementById("urlInput");
      const startBtn = document.getElementById("btnStartCycle");
      const stopBtn = document.getElementById("btnStopCycle");
      const url = urlInput ? urlInput.value.trim() : "";
      const useCurrentScreen = document.getElementById("cycleUseCurrentScreen")?.checked ?? false;
      const packageName = document.getElementById("packageNameInput")?.value.trim() || "";

      if (!url && !useCurrentScreen) {
        alert("Por favor introduce el enlace de la publicación de Instagram (ej. https://www.instagram.com/p/...) o marca 'Usar publicación actual en pantalla'.");
        if (urlInput) urlInput.focus();
        return;
      }

      const doLike = document.getElementById("cycleDoLike")?.checked ?? true;
      const doComment = document.getElementById("cycleDoComment")?.checked ?? true;
      const repeatCycles = document.getElementById("cycleRepeat")?.checked ?? false;
      const cycleCount = parseInt(document.getElementById("cycleCountInput")?.value) || 1;
      const accountsToUse = parseInt(document.getElementById("accountsToUseInput")?.value) || 0;
      const narrative = document.getElementById("cycleNarrativeSelect")?.value || "a_favor";
      const tone = document.getElementById("cycleToneSelect")?.value || "auto";
      const customComment = document.getElementById("cycleCustomComment")?.value.trim() || "";
      const visionModel = document.getElementById("selectVisionModel")?.value || "";
      const textModel = document.getElementById("selectTextModel")?.value || "";

      if (!doLike && !doComment) {
        alert("Selecciona al menos una acción: Dar Like o Comentar con IA.");
        return;
      }

      // Contexto de la Publicación: se usa directamente lo ingresado en el campo manual
      const manualContext = document.getElementById("manualContextPostText")?.value.trim() || "";
      const isContest = document.getElementById("manualContextIsContest")?.checked ?? false;
      const contestRequirement = document.getElementById("manualContextContestReq")?.value.trim() || "";
      const teamsOrTopic = document.getElementById("manualContextContestTopic")?.value.trim() || "";
      const mediaType = document.getElementById("mediaTypeInput")?.value || "post";

      // Modo de comentarios y banco de comentarios pegados
      const commentMode = document.getElementById("selectedCommentMode")?.value || "auto";
      const pastedComments = (document.getElementById("pastedCommentsTextarea")?.value || "")
        .split("\n").map(s => s.trim()).filter(Boolean);

      if (doComment && commentMode === "preset_list" && pastedComments.length === 0) {
        alert("Has seleccionado el Modo 'Lista Predefinida', pero tu banco de comentarios pegados está vacío. Por favor pega tus comentarios en la pestaña 'Comentarios & Análisis' a la derecha o selecciona 'Modo Autónomo IA'.");
        switchTab('comments');
        document.getElementById("pastedCommentsTextarea")?.focus();
        return;
      }

      // UI state updates
      if (startBtn) {
        startBtn.disabled = true;
        startBtn.classList.add("opacity-50", "cursor-not-allowed");
      }
      if (stopBtn) {
        stopBtn.disabled = false;
        stopBtn.classList.remove("opacity-30", "cursor-not-allowed");
      }

      // Hide error alert & show status widget
      document.getElementById("cycleErrorAlert")?.classList.add("hidden");
      document.getElementById("cycleCommentBox")?.classList.add("hidden");
      const statusWidget = document.getElementById("cycleStatusWidget");
      if (statusWidget) statusWidget.classList.remove("hidden");

      const badge = document.getElementById("cycleAccountBadge");
      const stepNum = document.getElementById("cycleStepNum");
      const stepMsg = document.getElementById("cycleStepMsg");
      const progressBar = document.getElementById("cycleProgressBar");

      const accInfo = accountsToUse > 0 ? `${accountsToUse} cuentas` : "todas las cuentas";
      if (badge) badge.innerText = `Iniciando (${cycleCount} ciclo${cycleCount > 1 ? 's' : ''}, ${accInfo})...`;
      if (stepNum) stepNum.innerText = "Paso 1";
      if (stepMsg) stepMsg.innerText = "Inspeccionando cuentas registradas en el dispositivo...";
      if (progressBar) progressBar.style.width = "6%";

      try {
        const res = await fetch("/api/cycle/start", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            url: url,
            media_type: mediaType,
            package_name: packageName,
            use_current_screen: useCurrentScreen,
            do_like: doLike,
            do_comment: doComment,
            repeat_cycles: repeatCycles,
            cycle_count: cycleCount,
            max_cycles: cycleCount,
            accounts_to_use: accountsToUse,
            narrative: narrative,
            tone: tone,
            custom_comment: customComment,
            vision_model: visionModel,
            text_model: textModel,
            manual_context: manualContext,
            is_contest: isContest,
            contest_requirement: contestRequirement,
            teams_or_topic: teamsOrTopic,
            comment_mode: commentMode,
            pasted_comments: pastedComments
          })
        });

        const data = await res.json();
        if (!data.success) {
          handleCycleError({ error: data.error || data.message || "Error al iniciar el ciclo multi-cuenta." });
        }
      } catch (e) {
        handleCycleError({ error: "Error de red o conexión al servidor: " + e });
      }
    }

    // Automatización Manual: Inicia directamente abriendo la publicación
    async function startManualAutomation() {
      const urlInput = document.getElementById("urlInput");
      const startManualBtn = document.getElementById("btnStartManual");
      const startCycleBtn = document.getElementById("btnStartCycle");
      const stopBtn = document.getElementById("btnStopCycle");
